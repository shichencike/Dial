// 泛型 map<K,V> 的 for (k, v in m) 迭代（v1.01）。
// 哈希表键顺序不确定，故示例只做「求和」这类与顺序无关的计算，保证黄金比对稳定。

fn main(): int {
    // int -> float：键之和 1+2+3=6，值之和 1.5+2.5+3.0=7.0
    var m1: map<int, float> = new_kv_map();
    m1.put(1, 1.5);
    m1.put(2, 2.5);
    m1.put(3, 3.0);
    var sk: int = 0;
    var sv: float = 0.0;
    for (k, v in m1) { sk += k; sv += v; }
    print(sk);     // 6
    print(sv);     // 7.000000

    // string -> int：键长度之和（每个长度 1）×3 = 3，值之和 10+20+30 = 60
    var m2: map<string, int> = new_kv_map();
    m2.put("a", 10);
    m2.put("b", 20);
    m2.put("c", 30);
    var kl: int = 0;
    var sv2: int = 0;
    for (k, v in m2) { kl += k.length(); sv2 += v; }
    print(kl);     // 3
    print(sv2);    // 60

    print(0);
}
