// dialc 性能基准：1000 万次数组 push + 遍历求和
//
// 这是 --fast 模式三层优化的「标准考题」：
//   ① 遍历求和 `s = s + a[j]` 在 --fast 下，dial_array_get 的越界检查被编译期消除，
//      LTO 再把 dial_array_get 整个内联进主循环，得到一个纯 load+add 的归约环，
//      于是 LLVM 的循环向量化器用 SIMD（x86 的 AVX2 / ARM64 的 NEON）一次吃 4 个 int64。
//   ② push 阶段：`dial_array_push` 同样被 LTO 内联，消灭函数调用开销。
//   ③ --pgo 下还会按真实运行热点重排指令布局，把热路径顶到 I-Cache 最前。
//
// 为让「向量化的求和环」在计时中占主导（而非被编译/链接时间喧宾夺主），
// 把求和重复 50 趟，并在每趟末尾轻微扰动 a[0]，使编译器无法把内层求和 hoist 出外层。
//
// 正确性锚点：单趟 sum(0..n-1) = n*(n-1)/2 = 49_999_995_000_000（n = 10_000_000）。

fn main(): int {
    var n: int = 10000000;

    // 构造数组：先放一个 0（空数组字面量暂不支持），再 push 1..n。
    var a: int[] = [0];
    for (i in 1..n) {
        a.push(i);
    }

    // 遍历求和（向量化 + LTO 内联的主战场），重复 50 趟。
    var acc: int = 0;
    for (k in 0..50) {
        var s: int = 0;
        for (j in 0..n) {
            s = s + a[j];
        }
        acc = acc + s;
        a[0] = s % 7; // 轻微扰动，破坏「数组不变」假设，阻止内层求和被 hoist
    }

    print("50 * sum(0..n-1) + 扰动 =");
    print(acc);
    return 0;
}
