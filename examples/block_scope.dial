// 裸块作用域（v0.98.2）：`{ ... }` 作为独立语句引入词法作用域
//
// 验证点：
//   1. 块内可遮蔽外层同名变量，离开块后外层不受影响
//   2. 块内的堆类型局部变量（string）在离开块时被释放（不泄漏）
//   3. 裸块可嵌套，每层各自成一个作用域
//   4. 块内计算不影响外层变量的值

fn main(): int {
    // 1. 变量遮蔽
    let x: int = 1;
    {
        let x: int = 2;
        print(x);          // 2 —— 遮蔽外层
    }
    print(x);              // 1 —— 外层从未被改动

    // 2. 块内堆类型局部变量（离开块时释放）
    {
        var s: string = "inner";
        print(s);          // inner
    }
    print("after block");  // after block

    // 3. 嵌套裸块
    {
        let y: int = 10;
        {
            let y: int = 20;
            print(y);      // 20 —— 内层遮蔽
        }
        print(y);          // 10 —— 回到中层
    }

    // 4. 块内累加不影响外层
    var acc: int = 0;
    for (i in 0..5) {
        {
            let t: int = i * 2;
            acc = acc + t;
        }
    }
    print(acc);            // 0+2+4+6+8 = 20

    return 0;
}
