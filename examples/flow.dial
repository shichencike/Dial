// dialc v0.1 示例：变量、while 循环、if/else 分支、函数调用
// 预期输出:
//   10
//   small
fn add(a: int, b: int): int {
    return a + b;
}

fn main(): int {
    var i: int = 0;
    var sum: int = 0;
    while (i < 5) {
        sum = add(sum, i);
        i = i + 1;
    }
    print(sum);

    if (sum > 10) {
        print("big");
    } else {
        print("small");
    }
    return 0;
}
