// dialc v0.5 示例：break / continue
//
// 关键正确性点：for 循环里的 continue **必须**先执行 i = i + 1 再回到条件判定。
// 实现上把自增放在独立的 for.inc 块，continue 跳到 for.inc 而非 for.cond——否则会死循环。

fn main(): int {
    // —— for + continue：跳过 i == 3 ——
    print("[lc] for 0..6 跳过 3 -> sum = 0+1+2+4+5 = 12 ->");
    var sum: int = 0;
    for (i in 0..6) {
        if (i == 3) {
            continue;
        }
        sum = sum + i;
    }
    print(sum);

    // —— for + break：到 i == 4 就跳出 ——
    print("[lc] for 0..100 在 i==4 处 break -> sum = 0+1+2+3 = 6 ->");
    var total: int = 0;
    for (j in 0..100) {
        if (j == 4) {
            break;
        }
        total = total + j;
    }
    print(total);

    // —— while + continue / break ——
    // n 自增写在循环体开头，因此 continue 不会漏掉自增。
    print("[lc] while 跳过 n==2、n>5 时 break -> acc = 1+3+4+5 = 13 ->");
    var n: int = 0;
    var acc: int = 0;
    while (n < 100) {
        n = n + 1;
        if (n == 2) {
            continue;
        }
        if (n > 5) {
            break;
        }
        acc = acc + n;
    }
    print(acc);

    return 0;
}
