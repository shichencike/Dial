// 数组元素类型扩展（v1.01）：float / byte / bool / char 现在都是合法的动态数组元素。
// 底层沿用 int64 槽位 —— float 以 IEEE754 位模式存储（绝不 fptosi 截断小数）、
// bool 以 i1<->i64 位模式、byte/char 与 int 同为 i64；句柄元素仍按元素 ARC 管理。
// 另含：空数组字面量 `[]` 带类型标注、数组删除方法 remove(i) / pop()。

fn main(): int {
    // float[]：温度平均值（此前只能定点数模拟）
    var temps: float[] = [36.5, 37.1, 38.2];
    var sum: float = 0.0;
    for (t in temps) { sum += t; }
    print(sum / 3.0);

    // byte[]：字节序列（此前只能改用 bytes 类型）
    var buf: byte[] = [int_to_byte(1), int_to_byte(255)];
    print(byte_to_int(buf[1]));

    // char[]：字符序列（此前只能改用 string）
    var cs: char[] = ['a', 'b', 'c'];
    print(cs.length());

    // bool[]：布尔标志（此前只能改用 int 0/1）
    var flags: bool[] = [true, false, true];
    print(flags[0]);
    print(flags[1]);

    // 空数组字面量 `[]`：必须带类型标注才能推断元素类型
    var empty: int[] = [];
    print(empty.length());

    // remove(i)：删除下标处元素并返回它（数组自身由 COW 写回更新）
    var a: int[] = [10, 20, 30, 40];
    print(a.remove(1));   // 删除 20
    print(a.length());    // 3

    // pop()：弹出末尾元素并返回它
    var b: int[] = [1, 2, 3];
    print(b.pop());       // 3
    print(b.length());    // 2

    // 句柄元素数组也能删除：被删句柄的所有权随返回移交，数组不再持有
    var names: string[] = ["a", "b", "c"];
    print(names.remove(0));   // "a"
    print(names.length());    // 2

    return 0;
}
