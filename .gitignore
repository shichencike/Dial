# 构建产物
/target/
/.dialc_build/
# 阶段 7：标准库预编译中间产物与最终包
/dist-stdlib/
*.dialpkg
# VS Code 插件安装包（发版时由 CI 现构建并附到 Release，不入库二进制）
*.vsix

# 编译 Dial 源码时会在同目录产出的目标文件（examples/、tests/ 等）
*.o

# 本地生成的测试日志（每次跑测试都会覆盖，不入库）
TEST_RUN_*.log
# 逐版本的一次性报告（内容已并入 CHANGELOG / README / 官网，不再逐版留档）
REPORT_*.md
# Python 缓存（tools/ 下的脚本会产生）
__pycache__/
*.pyc
token.txt
examples/hello
examples/flow
examples/array_demo
examples/bench_array
examples/channel_thread

# CVE 检测器编译出的临时二进制（tools/cve_check.py 运行产物）
tests/cve/poc_*
