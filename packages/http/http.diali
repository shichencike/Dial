// http.dialpkg —— HTTP/1.1 + HTTP/2 客户端（Dial 语言接口签名）
//
// 本文件是**唯一**的对外契约：包内机器码的实现可以变，但这里的签名一变，
// 依赖它的程序就得重编。签名文件带 SHA256 校验，被篡改会在链接期被拦下。
//
// 设计立场（详见 packages/http/src/dial_http.h 的注释）：
//   - 协议层自研：报文解析、Header 拼装、Socket 读写都在我们手里；
//   - 密码学绝不手搓：TLS 1.3 由 vendor 的 mbedtls 提供（证书校验 fail-closed）；
//   - 压缩用成熟实现：gzip / deflate 解压走 zlib；
//   - HTTP/2 分帧 + HPACK 自研（静态表 + Huffman 解码 + 动态表），
//     https 走 ALPN 协商 h2、明文走 h2c prior-knowledge；
//   - 两层 API：底层「流式」可自由拼报文，高层「一次请求」省心；
//   - 错误走返回码 + 最近错误槽，不抛 Dial 异常（包不假定宿主装了异常栈）。
//   - 客户端画像只做兼容性配置（头序 / UA / ALPN），**不做以规避识别为目标的
//     绕检测逻辑**。

/// HTTP 连接句柄（不透明）。用完必须显式 dial_http_close 释放——不透明句柄不进 ARC。
type HttpConn;

/// HTTP 响应句柄（不透明）。用完必须显式 dial_http_resp_free 释放。
type HttpResponse;

/// HTTP/2 会话句柄（不透明，一条连接 = 多个并发 stream）。
/// 不进 ARC：多个 spawn worker 可按值共享同一句柄，用完由
/// dial_http2_session_free 显式释放（须在所有 worker join 之后）。
type Http2Session;

// ---- 底层：流式（连接级）------------------------------------------

/// 解析 URL 并建立 TCP 连接（**不**发送任何请求）。
/// URL 形如 http://host[:port]/path[?query]；省略 scheme 按 http 处理，省略端口按 80。
/// 失败返回空句柄（用 is_null 判断），原因见 dial_http_last_error_msg。
extern fn dial_http_connect(url: string): HttpConn;

/// 往连接里写入一段文本（请求行 / 头 / 体都靠它）。返回写入字节数，失败返回 -1。
extern fn dial_http_write(conn: HttpConn, data: string): int;

/// 按「行」写：写完自动补 CRLF（HTTP 的行结束符）。
/// Dial 字符串字面量只支持 \n \t \\ \" 四种转义、**不支持 \r**，
/// 所以行结束符由包负责——调用方按行写，不必自己拼转义。
extern fn dial_http_write_line(conn: HttpConn, line: string): int;

/// 读一行（到换行为止，不含换行符）。失败返回空句柄。
extern fn dial_http_read_line(conn: HttpConn): string;

/// 读到连接关闭为止，返回全部字节。失败返回空句柄。
extern fn dial_http_read_all(conn: HttpConn): bytes;

/// 关闭连接并释放句柄。返回 0 成功。
extern fn dial_http_close(conn: HttpConn): int;

/// 设置收发超时（秒）；传 0 表示不限时。必须在 connect 之前调用才生效。
extern fn dial_http_set_timeout(conn: HttpConn, seconds: int): int;

// ---- 高层：一次请求一个响应----------------------------------------

/// 发 GET 请求并读完响应。
/// headers 是额外请求头，每行一个 "Name: value"（不含末尾换行）；传空串表示不加。
/// 失败返回空句柄（用 is_null 判断）。
extern fn dial_http_get(url: string, headers: string): HttpResponse;

/// 发 POST 请求并读完响应。body 为请求体（可传空串），content_type 可传空串表示不发该头。
extern fn dial_http_post(url: string, headers: string, body: string, content_type: string): HttpResponse;

/// 响应状态码（200 / 404 / 500 …）。句柄为空时返回 -1。
extern fn dial_http_resp_status(resp: HttpResponse): int;

/// 响应体（bytes；已按 Content-Encoding 解压过）。句柄为空时返回空句柄。
extern fn dial_http_resp_body(resp: HttpResponse): bytes;

/// 响应体字节长度。
extern fn dial_http_resp_body_len(resp: HttpResponse): int;

/// 按名字取响应头（大小写不敏感）。缺失返回空串。
extern fn dial_http_resp_header(resp: HttpResponse, name: string): string;

/// 响应头个数（便于遍历）。
extern fn dial_http_resp_header_count(resp: HttpResponse): int;

/// 按序号取响应头名 / 头值。越界返回空串。
extern fn dial_http_resp_header_name(resp: HttpResponse, index: int): string;
extern fn dial_http_resp_header_value(resp: HttpResponse, index: int): string;

/// 释放响应句柄。返回 0 成功。
extern fn dial_http_resp_free(resp: HttpResponse): int;

// ---- 客户端画像（兼容性配置，非规避引擎）----------------------------

/// 切换客户端画像：目前 "default"（默认）与 "chrome"。
/// 画像只控制请求头排序与 User-Agent 这类兼容参数（与只认浏览器客户端的
/// API 互通），**不以“绕过服务器限制 / 欺骗识别”为目标**。
extern fn dial_http_set_profile(name: string): void;

/// 设置自定义受信 CA（文件或目录，PEM）；传空串恢复系统根证书库。
/// 用于内网 / 私有 CA 场景；证书校验依旧 fail-closed（自签名不可冒用）。
extern fn dial_http_set_ca_path(path: string): void;

// ---- 连接池统计（供测试 / 诊断）-------------------------------------

/// keep-alive 连接池命中次数（复用已建立连接）。
extern fn dial_http_pool_hits(): int;

/// 取连接总次数（含新建）。
extern fn dial_http_pool_total(): int;

/// 清空连接池（释放所有空闲连接）。
extern fn dial_http_pool_clear(): void;

// ---- HTTP/2：会话式多路复用（RFC 7540，v1.05 增补）------------------

/// 建立 HTTP/2 会话：https:// 走 TLS 1.3 + ALPN 协商 h2；http:// 走明文 h2c
/// prior-knowledge。ALPN 未协商出 h2 时 fail-closed 报错（绝不静默降级 http/1.1）。
/// 失败返回空句柄（is_null 判断），原因见 dial_http_last_error_msg。
extern fn dial_http2_connect(url: string): Http2Session;

/// 在会话上发一个请求并阻塞到该 stream 的响应收齐。多线程可并发调用同一会话，
/// 帧在单条连接上按 stream id 交错分发。method 如 "GET"/"POST"，path 如 "/ok"，
/// headers 为每行一个 "Name: value" 的额外请求头（可空串），body 可空串。
/// 返回 HttpResponse（复用上面全部访问器）；失败/被 GOAWAY 返回空句柄。
extern fn dial_http2_request(sess: Http2Session, method: string, path: string, headers: string, body: string): HttpResponse;

/// 关闭会话：停 I/O 线程、关连接、释放资源。返回 0 成功。
extern fn dial_http2_session_free(sess: Http2Session): int;

/// 最近一次 connect 协商出的协议："h2" / "h2c" / "none"（线程局部，供测试断言）。
extern fn dial_http2_last_protocol(): string;

/// TLS 协商出的 ALPN："h2" / "none"（线程局部）。
extern fn dial_http2_alpn(): string;

/// 进程级累计：成功建立的会话数 / 累计发出的 stream 数（证明单连接多路分流）。
extern fn dial_http2_conn_count(): int;
extern fn dial_http2_stream_count(): int;

// ---- 最近一次请求的 TLS 协商信息（线程局部）-------------------------

/// 协商出的 TLS 版本（如 "TLS1.3"）；明文请求返回 "none"。
extern fn dial_http_last_tls_version(): string;

/// 证书校验结果位掩码（0 = 通过；非 0 = 见 mbedTLS 校验标志）。
extern fn dial_http_last_tls_verify(): int;

/// 协商出的 ALPN（如 "http/1.1"）；未协商返回 "none"。
extern fn dial_http_last_tls_alpn(): string;

// ---- 错误诊断-------------------------------------------------------

/// 最近一次错误的码（0 表示无错误；负值见 README 的错误码表）。
extern fn dial_http_last_error(): int;

/// 最近一次错误的人话描述（中文）。
extern fn dial_http_last_error_msg(): string;
