    fn event_height(self): int { return dial_gui_event_height(self); }
    fn event_window(self): GuiWindow { return dial_gui_event_window(self); }
    fn window_new(self, title: string, w: int, h: int): GuiWindow { return dial_gui_window_new(self, title, w, h); }
    fn painter_offscreen(self, w: int, h: int): GuiPainter { return dial_gui_painter_offscreen(w, h); }
    fn font_default(self): GuiFont { return dial_gui_font_default(); }
    fn font_load(self, path: string): GuiFont { return dial_gui_font_load(path); }
    fn last_error(self): int { return dial_gui_last_error(); }
    fn last_error_msg(self): string { return dial_gui_last_error_msg(); }
    fn clear_error(self): int { return dial_gui_clear_error(); }
    fn backend(self): string { return dial_gui_backend(); }
    fn widget_tree(self, w: int, h: int): GuiWidget { return dial_gui_widget_tree(w, h); }
    fn event_widget(self): GuiWidget { return dial_gui_event_widget(self); }
    fn event_data(self): rawptr<byte> { return dial_gui_event_data(self); }
    fn theme_role_count(self): int { return dial_gui_theme_role_count(); }
    fn theme_get(self, role: int): int { return dial_gui_theme_get(role); }
    fn theme_set(self, role: int, color: int): int { return dial_gui_theme_set(role, color); }
    fn theme_reset(self): int { return dial_gui_theme_reset(); }
    fn signal_count(self): int { return dial_gui_signal_count(); }
    fn signal_capacity(self): int { return dial_gui_signal_capacity(); }
    fn menu_new(self): GuiMenu { return dial_gui_menu_new(); }
    fn dialog_new(self): GuiDialog { return dial_gui_dialog_new(); }
}

