// gui_oo.dial —— 手搓 GUI 第 8 层：Dial 侧惯用 API（OO 封装层）
//
// 本文件是**纯 Dial 源码**，不是包、不进 gui.dialpkg：gui.diali / C 层 /
// 三平台 .a / abi=6 / version=1.10.0 / 旧 154 个签名一律一字不动。
// 它借 B1「impl 方法块」把 C 风格函数编译期脱糖成方法：
//     win.draw()  ==  dial_gui_window_draw(win)
// 纯编译期改写，产物与 C 风格调用逐字节一致，ABI 不变。
//
// 用法（v1.04 本地源码模块，README §34）：把本文件放到项目目录，写一行
//     import "./gui_oo.dial";        // 或裸名 import "gui_oo";
// 本文件内的 import "gui"; 会由前端汇总、去重后全局生效，故用户**不必**再写
// 第二个 import；随后 dial_gui_app_new() 建 app，其余一律走方法。
//
// 映射规则（便于逐条审计）：方法名 = 去掉 `dial_gui_` 与接收者类型前缀后的
// 剩余部分；第一个形参是 7 个句柄之一时挂到该类型并降为 self，否则归到
// GuiApp 作命名空间（self 被忽略，语义仍是进程级全局状态 / 工厂）。
// 两处为绕开保留字改名：widget_select -> select_range（select 是关键字）、
// menu_add_item 的形参 label -> txt（label 是关键字）；第 10 层 context 的
// select -> select_item（select 是关键字）。
//
// 现役边界（如实标注，不夸大）：
//   - B1 不支持关联函数，故 app 自身仍用 dial_gui_app_new()；工厂以
//     app.window_new(...) / app.menu_new() 等形式提供（self 仅作命名空间）。
//   - self 是值语义句柄副本；opaque 句柄本质是指针，方法内操作作用于同一对象。
//   - 本层不定义任何顶层辅助函数 / const（避免与用户源码跨文件撞名），
//     也不重新声明 extern fn dial_gui_*（会与 .diali 契约撞名被 Fail-Fast 拒绝）。
//   - LSP 当前不递归本地源码模块（v1.04 既有局限），CLI build/run/check/test 不受影响。
//
// 覆盖：184 个 extern fn -> 183 个方法 + 1 个入口 dial_gui_app_new。
// （第 8 层 153 + 第 9 层 15 + 第 10 层 15 = 183 个方法）

import "gui";


// ===== GuiApp —— 事件循环 / 事件字段 / 全局状态与工厂（self 仅作命名空间） =====
impl GuiApp {
    fn free(self): int { return dial_gui_app_free(self); }
    fn poll(self): int { return dial_gui_app_poll(self); }
