// gui.dialpkg —— 手写 GUI（窗 / 事件 / 2D 绘图 / Widget 树 / 布局 / 命中测试 /
// 主动事件分发 / 成品控件外观 / TextBox 输入与焦点链 / 可覆写主题色 /
// Radio·Slider·ProgressBar / 信号槽·控件事件订阅），Dial 语言接口签名
//
// 本文件是**唯一**的对外契约：包内机器码的实现可以变，但这里的签名一变，
// 依赖它的程序就得重编。签名文件带 SHA256 校验，被篡改会在链接期被拦下。
//
// 设计立场（详见 packages/gui/src/dial_gui.h 与 README §38）：
//   - 不用 Qt / GTK / SDL：窗口、事件、光栅化全部自己写 C；
//   - Linux / Termux：X11 + **XShm** 共享内存离屏像素 + **XRender** Picture
//     合成（SetPictureFilter 平滑缩放 + 梯形 AA 接口）；
//   - Windows：Win32 GDI CreateDIBSection 离屏 BGRA + StretchBlt 上屏
//     （SetStretchBltMode(HALFTONE) 对应 XRender 平滑 filter），
//     Win32 消息循环映射成同一套事件码，Dial 侧代码平台无关；
//   - 平台库一律 **dlopen / LoadLibraryA 动态装载**：三平台 .a 自包含，
//     Dial 侧不需要写 link，也不需要链接期注入 -lX11 / -lgdi32；
//     缺库返回明确错误码 + 最近错误槽，绝不静默崩溃；
//   - 2D 光栅化器自研：ARGB32 像素缓冲 + 覆盖面积采样 AA（1/2/4/8 倍），
//     矩形 / 线 / 圆 / 椭圆 / 梯形 / 位图 / 裁剪 / alpha 混合；
//   - 字体双路径：内置 8x8 ASCII 点阵（零依赖兜底）+ 可选 TrueType
//     （stb_truetype.h v1.26，MIT）。**只加载本机可信字体文件**，
//     绝不解析来自网络的字体（上游明确不做 TTF 偏移量范围检查）；
//   - 错误走返回码 + 最近错误槽，不抛 Dial 异常；句柄不进 ARC，必须显式 free。
//
// 颜色约定：所有 color 参数都是 **0xAARRGGBB**  packed 进 int64（高 32 位为 0）。
// C 侧在 X11 走 ARGB32、在 GDI 走 BGRA，通道转换由包内部负责，Dial 侧无感。
//
// 事件码（dial_gui_app_poll / dial_gui_app_wait 的返回值）：
//   0 NONE        1 MOUSE_PRESS   2 MOUSE_RELEASE   3 MOUSE_MOVE
//   4 KEY_PRESS   5 KEY_RELEASE   6 RESIZE          7 EXPOSE
//   8 CLOSE       9 QUIT
// 取事件字段用下面的 dial_gui_event_* 访问器（每 App 一份最近事件槽）。
//
// 功能键码（dial_gui_event_key）：两平台**统一**，起点 0x110000（十进制 1114112），
// 大于 Unicode 最大码点 0x10FFFF，绝不与可打印字符的码点冲突。X11 KeySym 与
// Win32 VK 都先映射进同一张表再进事件槽，表外键收敛为 GUI_KEY_UNKNOWN
// （0x11003F），绝不把平台私有值漏给 Dial 侧。可打印字符仍是 Unicode 码点。
// 修饰键位掩码由 dial_gui_event_mods 取（1 SHIFT / 2 CTRL / 4 ALT，按位或）。
// 统一键码（相对 0x110000 的偏移）：+1 BACKSPACE +2 TAB +3 ENTER +4 ESCAPE
// +5 LEFT +6 UP +7 RIGHT +8 DOWN +9 HOME +10 END +11 PAGEUP +12 PAGEDOWN
// +13 DELETE +14 SHIFT +15 CONTROL +16 ALT +17..+28 F1..F12 +63 UNKNOWN。
//
// 已实现范围（C 侧七层框架 + 第 9 层滚动视图，共 169 个 extern fn；第 8 层是
//   Dial 侧 OO 封装 gui_oo.dial，纯源码复用下列 extern fn，不在此契约）：
//   1) 地基层：Application / Window / Painter / Event / Font（55 个函数）；
//   2) 控件框架层：GuiWidget 树 + 绝对 / VBox / HBox 布局 + 命中测试 +
//      主动事件分发（28 个函数）；
//   3) 成品控件外观层：Label / Button / CheckBox 三种控件 + C 侧内置浅色
//      默认主题 + 四态（普通 / 悬停 / 按下 / 禁用）绘制 + 纯值事件推进 +
//      整树一次绘制（12 个函数）；
//   4) 输入层：TextBox 单行编辑（字符 / 退格 / 删除 / 光标 / 选区 / 输入上限）
//      + 焦点链（Tab / Shift+Tab 环形切换 / 点击聚焦）+ 统一功能键码与修饰键
//      （14 个函数，含 dial_gui_event_mods）；
//   5) 主题层 + 控件扩展：14 个可覆写颜色角色（set / get / reset / count）+
//      Radio / Slider / ProgressBar 三种成品控件 + value / range / group 纯值
//      访问器（11 个函数）；
//   6) 信号槽 / 控件事件订阅：7 类可订阅纯值信号 + 每树环形队列 +
//      subscribe / pending / data / pop / clear / dropped（10 个函数，见末段）；
//   7) 菜单 / 对话框：顶栏菜单 + 弹出菜单（菜单对象增删 / 命中 / 绘制）+
//      模态对话框（标题 / 消息 / 按钮 / 选中结果）+ 窗口级统一绘制与事件分发
//      （24 个函数，见末段）。菜单项 / 对话框按钮的选中事件复用第 6 层信号
//      队列（GUI_SIG_SELECTED / GUI_SIG_SUBMITTED），kind 标记 MENU / DIALOG。
// 七层一律只追加 extern fn：旧 130 个签名一字不动，
// abi = 6 / version = 1.10.0 / GuiWidgetEvent 104 字节布局 /
// GuiWidgetSignal 72 字节布局全部不变。
// 外观层 / 输入层 / 主题层 / 信号层 / 菜单对话框层仍是**纯 C、零平台符号、零反向回调**：
// 控件种类 / 文本 / 状态 / 颜色 / 信号全是 C 侧纯值或自有副本，Dial 侧用
// widget_draw(root, painter) 把整棵树画到任意 GuiPainter（离屏或窗口画布），
// 不需要也不允许 C 去调 Dial 函数。
//
// 事件分发立场（内存宪法）：**绝不做 C → Dial 反向回调**。Dial 无 GC，
// 全靠 ARC + 手动释放；C 侧若在平台线程直接调 Dial 函数，跨线程引用计数
// 管理会失控。因此 C 侧只把事件写成一个 **packed struct 纯值块**，由 Dial
// 侧主动 poll/wait 后读走：纯值字段直接读，带字符串的字段是 C 侧**借用**
// 的 const char*，Dial 侧必须用 string_from_cstr 复制成自己的 ARC 对象。
// C 管 C 的，ARC 管 ARC 的，谁也不越界，零隐式开销。
//
// 仍未实现、因此**不写进本契约**：多行文本 / 输入法（IME）、
// 撤销重做栈、富文本编辑、图片解码、Direct2D、C → Dial 反向回调。
// 把未实现的函数写进 .diali 会让用户 import 后链接失败，那是制造漂移
// 而非预留接口——这条原则六层一律适用。
// 注：信号槽已由第 6 层以「可订阅纯值信号队列」落地（不是 C 侧回调），
// 见本文件末段；「真正的 C→Dial 反向回调」仍是永久否决项。
// 真实事件注入由 XTest / xdotool 在 Xvfb 实窗里跑通（AA 组），
// 无头纯 C 树断言覆盖命中 / 四态 / 编辑 / 焦点环 / 主题 / 值域的全部逻辑分支。

/// GUI 应用上下文（不透明）。持有显示连接、窗口表、事件循环状态与最近事件槽。
/// 用完必须 dial_gui_app_free 释放——不透明句柄不进 ARC。
type GuiApp;

/// 窗口句柄（不透明）。一个 App 可持有多个窗口。
type GuiWindow;

/// 离屏像素画布（不透明）。可绑定窗口（dial_gui_window_painter），也可纯内存
/// 独立创建（dial_gui_painter_offscreen，不开窗、不依赖显示服务器，供像素级测试）。
type GuiPainter;

/// 字体句柄（不透明）。内置点阵由 dial_gui_font_default 返回，
/// TrueType 由 dial_gui_font_load 加载；用完一律 dial_gui_font_free。
type GuiFont;

/// 控件句柄（不透明，通用 Box）。裸指针，不进 ARC：独立树必须
/// dial_gui_widget_tree_free 显式释放；挂到窗口后由窗口拥有，随
/// dial_gui_window_close 释放，此后不得再 free（同画布的 ext_pixels 口径）。
type GuiWidget;

// ---- 应用 / 事件循环 --------------------------------------------------

/// 创建应用上下文。失败返回空句柄（is_null 判断），原因见 dial_gui_last_error_msg。
/// 内部按需 dlopen 平台库：Linux/musl 为 libX11 / libXext / libXrender，
/// Windows 为 user32 / gdi32（不需要 msimg32；上屏用 gdi32 的 StretchBlt +
/// SetStretchBltMode）。缺任一必需库即失败并给出库名。
extern fn dial_gui_app_new(): GuiApp;

/// 释放应用上下文，同时关闭并释放其下所有窗口 / 画布 / 字体。返回 0 成功。
extern fn dial_gui_app_free(app: GuiApp): int;

/// 非阻塞轮询一个事件，返回事件码（无事件返回 0）。每次调用只泵一次平台事件队列。
extern fn dial_gui_app_poll(app: GuiApp): int;

/// 阻塞等待一个事件，超时 timeout_ms 毫秒后返回 0。timeout_ms < 0 表示无限等待。
/// 事件循环典型写法：while (dial_gui_app_wait(app, 16) >= 0) { ... }。
extern fn dial_gui_app_wait(app: GuiApp, timeout_ms: int): int;

/// 请求退出事件循环（下一轮 poll/wait 返回 9 QUIT）。
extern fn dial_gui_app_quit(app: GuiApp): int;

/// 是否已收到退出请求。
extern fn dial_gui_app_should_quit(app: GuiApp): int;

// ---- 事件字段访问器（最近一次 poll/wait 产出的事件）--------------------

/// 最近事件码（与 poll/wait 返回值一致）。
extern fn dial_gui_event_kind(app: GuiApp): int;
/// 鼠标 X（窗口客户区坐标，像素）。
extern fn dial_gui_event_x(app: GuiApp): int;
/// 鼠标 Y（窗口客户区坐标，像素）。
extern fn dial_gui_event_y(app: GuiApp): int;
/// 鼠标按键号：1 左 / 2 中 / 3 右；滚轮用 4 / 5。非鼠标事件为 0。
extern fn dial_gui_event_button(app: GuiApp): int;
/// 键码：可打印字符为 Unicode 码点；功能键是**两平台统一**的 0x110000+ 键码
/// （见文件头键码表与 README §38.2），非键盘事件为 0。
extern fn dial_gui_event_key(app: GuiApp): int;
/// 最近事件的修饰键位掩码：1 SHIFT / 2 CTRL / 4 ALT（按位或）；非键盘事件为 0。
extern fn dial_gui_event_mods(app: GuiApp): int;
/// RESIZE 事件的新宽度。
extern fn dial_gui_event_width(app: GuiApp): int;
/// RESIZE 事件的新高度。
extern fn dial_gui_event_height(app: GuiApp): int;
/// 产生该事件的窗口句柄（可能为窗口级伪事件，用 is_null 判断）。
extern fn dial_gui_event_window(app: GuiApp): GuiWindow;

// ---- 窗口 ------------------------------------------------------------

/// 创建窗口。title 为 UTF-8 字符串；w/h 为客户区初始尺寸（像素）。
/// 失败返回空句柄，原因见 dial_gui_last_error_msg。
extern fn dial_gui_window_new(app: GuiApp, title: string, w: int, h: int): GuiWindow;

/// 关闭并释放窗口（同时释放其绑定的画布）。返回 0 成功。
extern fn dial_gui_window_close(win: GuiWindow): int;

/// 映射窗口到屏幕（创建后默认已映射，此函数用于重新显示）。
extern fn dial_gui_window_show(win: GuiWindow): int;

/// 修改窗口标题。
extern fn dial_gui_window_set_title(win: GuiWindow, title: string): int;

/// 修改客户区尺寸；会重建离屏像素缓冲（XShm 段 / DIBSection）并触发 RESIZE。
extern fn dial_gui_window_resize(win: GuiWindow, w: int, h: int): int;

/// 取当前客户区宽度。
extern fn dial_gui_window_width(win: GuiWindow): int;
/// 取当前客户区高度。
extern fn dial_gui_window_height(win: GuiWindow): int;

/// 取该窗口绑定的离屏画布（窗口拥有它，不要单独 free）。
extern fn dial_gui_window_painter(win: GuiWindow): GuiPainter;

/// 把离屏画布送上屏幕：Linux 先 XShmPutImage 零拷贝上传共享内存到中转
/// Pixmap，再 XRenderComposite（Picture + filter）合成到窗口；Windows 走
/// SetStretchBltMode(HALFTONE) + StretchBlt。返回 0 成功。
extern fn dial_gui_window_flush(win: GuiWindow): int;

/// 设置合成过滤器："fast" / "good" / "best" / "nearest"。Linux 走
/// XRenderSetPictureFilter；Windows 据此选 SetStretchBltMode（good/best →
/// HALFTONE）并写进后端能力串。非法值返回 -1。用于窗口缩放时的平滑抗锯齿。
extern fn dial_gui_window_set_filter(win: GuiWindow, filter: string): int;

/// 返回后端能力串，例如 "x11/xshm/xrender argb32 filter=best visual_depth=24"
/// 或 "win32/gdi/dibsection bgra filter=best stretch=halftone"。
/// 供测试断言 XShm / XRender 确已绑定。
extern fn dial_gui_window_backend(win: GuiWindow): string;

// ---- 离屏画布（可脱离显示服务器独立使用）------------------------------

/// 创建纯内存离屏画布（不开窗、不连 X11/GDI）。用于像素级单测与离屏渲染。
extern fn dial_gui_painter_offscreen(w: int, h: int): GuiPainter;

/// 释放纯内存离屏画布。窗口绑定的画布由 window_close 释放，不要对它调用。
extern fn dial_gui_painter_free(p: GuiPainter): int;

/// 画布宽度 / 高度。
extern fn dial_gui_painter_width(p: GuiPainter): int;
extern fn dial_gui_painter_height(p: GuiPainter): int;

/// 设置抗锯齿倍率：1（关闭）/ 2 / 4 / 8（覆盖面积子采样）。默认 4。
extern fn dial_gui_set_aa(p: GuiPainter, level: int): int;

/// 设置当前前景色（0xAARRGGBB）。后续绘制调用都用它。
extern fn dial_gui_set_color(p: GuiPainter, color: int): int;

/// 整块填充为当前前景色（忽略裁剪区外的部分）。
extern fn dial_gui_clear(p: GuiPainter, color: int): int;

/// 设置裁剪矩形；之后所有绘制只影响该区域。
extern fn dial_gui_set_clip(p: GuiPainter, x: int, y: int, w: int, h: int): int;
/// 取消裁剪。
extern fn dial_gui_clear_clip(p: GuiPainter): int;

/// 实心矩形。
extern fn dial_gui_fill_rect(p: GuiPainter, x: int, y: int, w: int, h: int): int;
/// 矩形描边，thickness 为线宽（像素）。
extern fn dial_gui_stroke_rect(p: GuiPainter, x: int, y: int, w: int, h: int, thickness: int): int;
/// 线段（两端为圆帽，覆盖面积 AA）。
extern fn dial_gui_draw_line(p: GuiPainter, x0: int, y0: int, x1: int, y1: int, thickness: int): int;
/// 实心圆。
extern fn dial_gui_fill_circle(p: GuiPainter, cx: int, cy: int, r: int): int;
/// 圆环描边，thickness 为线宽。
extern fn dial_gui_stroke_circle(p: GuiPainter, cx: int, cy: int, r: int, thickness: int): int;
/// 实心椭圆（rx/ry 为半轴）。
extern fn dial_gui_fill_ellipse(p: GuiPainter, cx: int, cy: int, rx: int, ry: int): int;

/// 梯形 AA 填充：上边 y0 从 x_tl 到 x_tr，下边 y1 从 x_bl 到 x_br。
/// 一律走**自研光栅化器**的覆盖面积子采样，画进 CPU 离屏缓冲，三平台结果逐像素一致，
/// 保证 get_pixel / painter_crc32 读得到。XRender 的矢量抗锯齿能力用在
/// dial_gui_window_flush 的 Picture 合成链（见 dial_gui_window_set_filter），
/// 而非绕过 CPU 缓冲直接画到窗口——否则像素断言与用户自绘会看到两套状态。
extern fn dial_gui_fill_trapezoid_aa(p: GuiPainter, y0: int, y1: int, x_tl: float, x_tr: float, x_bl: float, x_br: float): int;

/// 直接读写单个像素（0xAARRGGBB）。用于像素级断言与自定义绘制。
extern fn dial_gui_get_pixel(p: GuiPainter, x: int, y: int): int;
extern fn dial_gui_set_pixel(p: GuiPainter, x: int, y: int, color: int): int;

/// 从一段 ARGB32 字节缓冲（长度须 >= w*h*4）贴图到 (dx,dy)，按 alpha 混合。
extern fn dial_gui_blit_pixels(p: GuiPainter, dx: int, dy: int, w: int, h: int, pixels: bytes): int;

/// 整块像素的 CRC32（自研、纯内存），供回归测试断言绘制结果稳定。
extern fn dial_gui_painter_crc32(p: GuiPainter): int;

// ---- 字体 / 文本 ------------------------------------------------------

/// 内置 8x8 ASCII 点阵字体（零依赖，任何环境都可用；无需 free 外部资源，
/// 但按统一契约仍要 dial_gui_font_free）。返回空句柄表示分配失败。
extern fn dial_gui_font_default(): GuiFont;

/// 从本机可信 TTF/OTF 文件加载字体。失败返回空句柄，原因见错误槽。
/// **绝不接受来自网络的字体数据**：stb_truetype 上游不做偏移量范围检查。
extern fn dial_gui_font_load(path: string): GuiFont;

/// 字体种类：0 内置点阵 / 1 TrueType。
extern fn dial_gui_font_kind(font: GuiFont): int;

/// 释放字体句柄。返回 0 成功。
extern fn dial_gui_font_free(font: GuiFont): int;

/// 在 (x,y) 处绘制 UTF-8 文本，size 为像素高度，颜色取当前前景色。
/// 返回绘制推进后的 x 坐标（便于连续排版）；失败返回 -1。
extern fn dial_gui_draw_text(p: GuiPainter, x: int, y: int, text: string, font: GuiFont, size: int): int;

/// 测量文本在给定字号下的像素宽度（不绘制）。
extern fn dial_gui_text_width(text: string, font: GuiFont, size: int): int;

// ---- 错误槽 ----------------------------------------------------------

/// 最近一次错误码：0 表示无错误。错误码表见 README §38。
extern fn dial_gui_last_error(): int;
/// 最近一次错误的人类可读说明（线程局部）。无错误时返回空字符串。
extern fn dial_gui_last_error_msg(): string;
/// 清空错误槽（成功路径也应调用，避免读到上一次的陈旧错误）。
extern fn dial_gui_clear_error(): int;

// ---- 平台信息 --------------------------------------------------------

/// 当前编译目标的后端名："x11" / "win32"。
extern fn dial_gui_backend(): string;

// ---- 控件框架层：Widget 树（通用 Box，无成品外观）----------------------
//
// 生命周期铁律：GuiWidget 是裸指针，不进 ARC。
//   - dial_gui_widget_tree 建的是**独立纯内存树**，不连显示服务器，
//     因此无 DISPLAY 环境也能完整跑布局 / 命中测试；
//   - 独立树用完必须 dial_gui_widget_tree_free；
//   - 挂到窗口（dial_gui_window_set_root）后由窗口拥有，随 window_close 释放，
//     此后再调 widget_tree_free 是二次释放，属于使用者责任。
// 所有返回 int 的函数：0 成功 / -1 失败（原因见错误槽）；返回句柄的失败返回空句柄。

/// 建一棵独立纯内存控件树，根 Box 的初始尺寸为 w×h。失败返回空句柄。
extern fn dial_gui_widget_tree(w: int, h: int): GuiWidget;

/// 释放整棵独立树（含根，后序递归）。挂过窗口的树不要调用。返回 0 成功。
extern fn dial_gui_widget_tree_free(root: GuiWidget): int;

/// 在 parent 下追加一个子 Box 并返回它（新子节点默认可见、无 id、布局 ABS）。
extern fn dial_gui_widget_add(parent: GuiWidget): GuiWidget;

/// 把 w 从父节点摘除并释放其整个子树。根不可摘除（返回 -1）。
extern fn dial_gui_widget_remove(w: GuiWidget): int;

/// 父节点（根返回空句柄）。
extern fn dial_gui_widget_parent(w: GuiWidget): GuiWidget;
/// 第一个子节点（无子返回空句柄）。
extern fn dial_gui_widget_first_child(w: GuiWidget): GuiWidget;
/// 下一个兄弟节点（末尾返回空句柄）。
extern fn dial_gui_widget_next_sibling(w: GuiWidget): GuiWidget;

// ---- 控件框架层：几何 / 可见 / id / 纯值标记 ---------------------------

/// 设置 Box 相对父节点的矩形。w/h > 0 视为**固定尺寸**，布局时优先保留；
/// w 或 h <= 0 表示该轴交给父布局弹性分配。
extern fn dial_gui_widget_set_rect(w: GuiWidget, x: int, y: int, ww: int, hh: int): int;
extern fn dial_gui_widget_x(w: GuiWidget): int;
extern fn dial_gui_widget_y(w: GuiWidget): int;
extern fn dial_gui_widget_width(w: GuiWidget): int;
extern fn dial_gui_widget_height(w: GuiWidget): int;

/// 可见性：不可见的 Box 不参与布局，也不参与命中测试。
extern fn dial_gui_widget_set_visible(w: GuiWidget, v: int): int;
extern fn dial_gui_widget_visible(w: GuiWidget): int;

/// 设置 id（C 侧 strdup 自有副本，输入 Dial string 不被接管）。
extern fn dial_gui_widget_set_id(w: GuiWidget, id: string): int;
/// 取 id 的 **C 侧借用指针**（const char*，未设置时为空串）。
/// 所有权在 C：必须立刻 string_from_cstr 复制成自己的 ARC string，
/// 绝不长期持有；控件释放后该指针悬垂。
extern fn dial_gui_widget_id(w: GuiWidget): rawptr<byte>;

/// tag / userdata 一律是 int64 **纯值键**，供 Dial 侧自建 map 映射控件状态。
/// 包内绝不存 Dial 指针、绝不碰 ARC（零隐式开销边界）。
extern fn dial_gui_widget_set_tag(w: GuiWidget, t: int): int;
extern fn dial_gui_widget_tag(w: GuiWidget): int;
extern fn dial_gui_widget_set_userdata(w: GuiWidget, u: int): int;
extern fn dial_gui_widget_userdata(w: GuiWidget): int;

// ---- 控件框架层：布局 -------------------------------------------------

/// 布局模式：0 ABS（子节点用自身 x/y/w/h，相对父）/ 1 VBOX（纵向弹性等分）
/// / 2 HBOX（横向弹性等分）。非法值返回 -1。
extern fn dial_gui_widget_set_layout(w: GuiWidget, mode: int): int;
/// 内容区四边内边距（像素，负数按 0）。
extern fn dial_gui_widget_set_padding(w: GuiWidget, n: int): int;
/// 相邻子节点间距（像素，负数按 0）。
extern fn dial_gui_widget_set_gap(w: GuiWidget, n: int): int;

/// 以 w×h 为根尺寸前序重算整棵树：先定父几何，再递归子节点。
/// 纯整数运算，固定尺寸优先扣减，弹性余量整数除法向下取整；**幂等**，
/// 重复调用不会叠加 padding / gap。
extern fn dial_gui_widget_layout_apply(root: GuiWidget, w: int, h: int): int;

// ---- 控件框架层：命中测试 / 挂窗 ---------------------------------------

/// 在树中做点命中：返回包含 (x,y) 的**最深可见** Box，后加子优先
/// （与 Dial 侧自绘层序一致）；未命中返回空句柄。x/y 为窗口客户区坐标。
extern fn dial_gui_widget_hit(root: GuiWidget, x: int, y: int): GuiWidget;

/// 把一棵独立树的根挂到窗口（root 必须无父、win 尚未挂树）。
/// 挂上后窗口拥有该树；不会自动调用 layout_apply，由 Dial 侧显式决定。
extern fn dial_gui_window_set_root(win: GuiWindow, root: GuiWidget): int;

// ---- 控件框架层：主动事件分发 -----------------------------------------

/// 最近一次 poll/wait 命中的控件句柄（窗口级 / QUIT 事件返回空句柄）。
/// 与 dial_gui_event_window 一样是 C 侧借用的裸句柄，不进 ARC。
extern fn dial_gui_event_widget(app: GuiApp): GuiWidget;

/// 返回 C 侧 **packed struct 纯值块**的地址（GuiWidgetEvent，104 字节），
/// Dial 侧声明同布局 packed extern struct 后 ptr_cast 读取：
///   int kind, x, y, button, key, w, h, local_x, local_y, tag, userdata  // 11×8 = 88
///   rawptr<byte> win_title   // @88  C 侧借用（窗口标题）
///   rawptr<byte> widget_id   // @96  C 侧借用（命中控件 id，未命中为 NULL）
/// 布局由 C 侧 _Static_assert 与 Dial 侧 sizeof/offsetof 编译期内建双向锁死。
/// 两个字符串指针由 C 拥有、C 绝不 free，有效期至**下次 poll/wait 或窗口/树释放**；
/// Dial 侧必须立即 string_from_cstr 复制，绝不长期持有。
extern fn dial_gui_event_data(app: GuiApp): rawptr<byte>;

// ---- 成品控件外观层：种类 / 文本 / 状态 / 主题绘制 ----------------------
//
// 立场：C 侧内置**浅色默认主题**（默认值逐字等于 GUI_THEME_* 宏），运行时可由
// 本文件末段的 theme_set 按角色覆写、theme_reset 逐值复位；控件种类与状态
// 全是 C 侧纯值或自有副本。绝不 C → Dial 反向回调：Dial 侧 poll/wait 拿到
// 事件后，用 widget_handle 把纯值事件喂进树推进四态，再用 widget_draw 把
// 整棵树一次画到任意 GuiPainter（离屏或窗口画布）。
//
// 控件种类（widget_set_kind / widget_kind）：
//   0 BOX      通用容器（浅色面板背景 + 细边框；框架层默认种类）
//   1 LABEL    只绘制文本（无背景 / 边框）
//   2 BUTTON   四态背景 + 边框 + 居中文本
//   3 CHECKBOX 方框 + 勾选标记 + 右侧文本，RELEASE 时自动翻转 checked
//   4 TEXTBOX  单行输入：白底 + 边框（焦点时高亮加粗）+ 选区底 + 文本 + 光标竖线；
//              RELEASE 命中即把焦点移过去（gui_widget_handle 返回 1）
//   5 RADIO    圆圈 + 选中点 + 右侧文本，RELEASE 选中；group != 0 时同组互斥
//   6 SLIDER   轨道 + 已填充 + 滑块，RELEASE 按局部 x 比例设 value
//   7 PROGRESS 轨道 + 边框 + 按 value 比例填充；只读，RELEASE 不激活
//
// 默认主题色（0xAARRGGBB，theme_reset 逐值复位，逐像素可断言）：
//   面板/BOX 背景 FFF4F6F9   边框 FFC7CEDA   文本 FF202733   禁用文本 FFA9B0BD
//   按钮 普通 FFE7ECF4 / 悬停 FFD3E0FA / 按下 FFB2C8F2 / 禁用 FFF0F2F5
//   勾选框 / Radio / TextBox 底 FFFFFFFF  勾 / 焦点边框 / 光标 / 高亮 FF2F6FE0
//   TextBox 选区底 FFC9DCFB（焦点态才画）
//   轨道底 FFE2E8F0   进度填充 FF2F6FE0   滑块 FFFFFFFF（MARK 描边）
// 默认值与引入 theme setter 之前逐字一致，look_crc_normal = 3884455222 不漂移。
// 文本用内置 8×8 ASCII 点阵（零依赖），字号固定 16（每字符 18×16 像素），
// 点阵不覆盖的码点画 '?'，与地基层的 gui_font_draw 同一套字形。
// TextBox 文本区裁剪到 (x+6, y, w-12, h)，光标恒定显示（不闪烁），
// 保证 get_pixel / painter_crc32 逐像素可断言、三平台一致。
//
// 四态由 widget_handle 推进：hovered / pressed 是运行时态（MOVE / PRESS 写，
// RELEASE 清），checked 是 CheckBox / Radio 勾选态（RELEASE 翻转 / 同组互斥），
// disabled 是显式设置的纯值态（禁用控件不 hover / 不 press / 不激活，
// 绘制走禁用配色）。

/// 设置控件种类（0 BOX / 1 LABEL / 2 BUTTON / 3 CHECKBOX / 4 TEXTBOX /
/// 5 RADIO / 6 SLIDER / 7 PROGRESS）；非法值返回 -1。
extern fn dial_gui_widget_set_kind(w: GuiWidget, kind: int): int;
extern fn dial_gui_widget_kind(w: GuiWidget): int;

/// 设置控件文本（C 侧 strdup 自有副本，按 C 字符串 NUL 结尾；输入 Dial string 不被接管）。
extern fn dial_gui_widget_set_text(w: GuiWidget, text: string): int;
/// 取文本的 **C 侧借用指针**（const char*，未设置时为空串）；所有权在 C，
/// 必须立刻 string_from_cstr 复制成 ARC string，绝不长期持有。
extern fn dial_gui_widget_text(w: GuiWidget): rawptr<byte>;

/// CheckBox 勾选态：显式设置 / 读取（0 未勾选 / 1 勾选）。
extern fn dial_gui_widget_set_checked(w: GuiWidget, v: int): int;
extern fn dial_gui_widget_checked(w: GuiWidget): int;
/// 禁用态：设置 / 读取（禁用控件不参与 hover / press / 激活，走禁用配色）。
extern fn dial_gui_widget_set_disabled(w: GuiWidget, v: int): int;
extern fn dial_gui_widget_disabled(w: GuiWidget): int;
/// 运行时态只读：当前是否悬停 / 按下（由 widget_handle 推进）。
extern fn dial_gui_widget_hovered(w: GuiWidget): int;
extern fn dial_gui_widget_pressed(w: GuiWidget): int;

/// 把一条**纯值事件**喂进控件树，推进四态：kind 用事件码（1 PRESS / 2 RELEASE
/// / 3 MOUSE_MOVE），x/y 为客户区坐标，button 为鼠标键（1 左键）。
/// MOVE 清/置 hovered、PRESS 清/置 pressed、RELEASE 清 pressed 并激活：
/// CHECKBOX 翻转 checked、BUTTON 记一次点击；disabled 控件不参与。
/// 返回 1 = 本次 RELEASE 激活了可交互控件 / 0 = 无激活 / -1 = 参数错误。
/// 命中取最深可见节点（复用框架层 widget_hit 口径）。被激活控件由 Dial 侧
/// 用 widget_hit(root, x, y) 自行取回，C 侧绝不返回或缓存 Dial 对象。
extern fn dial_gui_widget_handle(root: GuiWidget, kind: int, x: int, y: int, button: int): int;

/// 把整棵树按默认主题 + 当前四态一次画到 GuiPainter（离屏或窗口画布均可）。
/// 前序递归、父先画后加子在上，只读控件纯值状态，不推进状态、不碰平台 API。
/// 绘制前应先 widget_layout_apply 定好几何；返回 0 成功 / -1 失败。
extern fn dial_gui_widget_draw(root: GuiWidget, p: GuiPainter): int;

// ---- 输入层：TextBox 单行编辑 / 焦点链（本段 13 个 + 上方事件访问器区
//      dial_gui_event_mods 1 个 = 本层共 14 个追加 extern fn）----------------
//
// 立场与前三层的宪法完全一致：**纯 C、零平台符号、零 C → Dial 反向回调**。
// 焦点是树根上的一个 C 侧裸指针，文本是控件自己的 strdup 副本，光标 / 选区
// 是 UTF-8 **字节偏移**（一律按字符边界对齐，绝不切断多字节序列）。
// Dial 侧典型事件循环（主动读，C 从不回调）：
//   var k: int = dial_gui_app_wait(app, 16);
//   if (k == 4) dial_gui_widget_key(root, k, dial_gui_event_key(app),
//                                  dial_gui_event_mods(app));
//   if (k == 1 or k == 2 or k == 3)
//       dial_gui_widget_handle(root, k, dial_gui_event_x(app),
//                              dial_gui_event_y(app), dial_gui_event_button(app));
//
// 可聚焦控件 = 可见 / 未禁用 / kind == 4 TEXTBOX；Tab 按加入顺序环形前进，
// Shift+Tab 反向。禁用的控件自动让焦点出栈；摘除子树时先清焦点指针，
// 绝不留下悬垂裸句柄。一棵树内至多一个 focused。
//
// 键盘编辑（widget_key 的 key 取值）：
//   - 可打印字符：插入光标处（有选区先替换），UTF-8 编码，受 max_len 约束；
//   - GUI_KEY_BACKSPACE / DELETE：删前 / 后一个字符（有选区则删选区）；
//   - GUI_KEY_LEFT / RIGHT / HOME / END：移动光标；带 SHIFT 时扩选区；
//   - GUI_KEY_TAB（+ SHIFT）：焦点环切换；GUI_KEY_ENTER：提交信号；
//   - GUI_KEY_ESCAPE：清选区；其它功能键 / 修饰键本身不编辑文本。

/// 显式把焦点设到 w（须是同一棵树内可见 / 未禁用的 TEXTBOX）；返回 0 / -1。
extern fn dial_gui_widget_set_focus(root: GuiWidget, w: GuiWidget): int;

/// 当前焦点控件（无焦点返回空句柄，用 is_null 判断）。
extern fn dial_gui_widget_focus(root: GuiWidget): GuiWidget;

/// 该控件是否持有焦点（1 / 0）。
extern fn dial_gui_widget_focused(w: GuiWidget): int;

/// Tab：焦点环前进一个可聚焦控件，返回新焦点（无可聚焦控件返回空句柄）。
extern fn dial_gui_widget_focus_next(root: GuiWidget): GuiWidget;

/// Shift+Tab：焦点环后退一个可聚焦控件，返回新焦点。
extern fn dial_gui_widget_focus_prev(root: GuiWidget): GuiWidget;

/// TextBox 光标字节偏移（非 TEXTBOX 恒为 0）。
extern fn dial_gui_widget_cursor(w: GuiWidget): int;

/// 显式移动光标并清选区；pos 自动 clamp 到 [0, len] 的 UTF-8 字符边界。
extern fn dial_gui_widget_set_cursor(w: GuiWidget, pos: int): int;

/// 选区起点 / 终点（字节偏移，二者相等表示无选区）。
extern fn dial_gui_widget_sel_start(w: GuiWidget): int;
extern fn dial_gui_widget_sel_end(w: GuiWidget): int;

/// 设置选区 [a,b]（自动 clamp 到字符边界，a==b 表示清选区）；a>b 时自动交换。
extern fn dial_gui_widget_select(w: GuiWidget, a: int, b: int): int;

/// 输入上限（UTF-8 字节数）：0 = 不限（仍受 4096 兜底），1..4096 有效；
/// 越界**明确返回 -1 并写错误槽**，绝不静默截断。只约束键盘输入，
/// widget_set_text 是显式 API 不受此限（但会把光标 / 选区归零）。
extern fn dial_gui_widget_set_max_len(w: GuiWidget, n: int): int;
extern fn dial_gui_widget_max_len(w: GuiWidget): int;

/// 把一条**键盘纯值事件**喂进树，推进编辑态 / 焦点环。kind 用事件码
/// （4 KEY_PRESS 才生效，5 KEY_RELEASE 忽略），key 取 dial_gui_event_key，
/// mods 取 dial_gui_event_mods。返回 0 无变化 / 1 文本或光标变化 /
/// 2 焦点变化 / 3 Enter 提交 / -1 参数错误。C 侧绝不返回或缓存 Dial 对象。
extern fn dial_gui_widget_key(root: GuiWidget, kind: int, key: int, mods: int): int;

// ---- 第 5 层：主题层 + 控件扩展（本段 11 个追加 extern fn）--------------
//
// 立场：与前四层宪法完全一致 —— 纯 C、零平台符号、零 C → Dial 反向回调、
// 只追加 extern fn。主题是**进程级静态颜色表**（GUI 单线程事件循环，无需
// 加锁），一次设置对之后所有 widget_draw 立即生效；每个 demo 是独立进程，
// 静态表天然从默认值起步，绝不污染其它用例的 CRC 基准。
//
// 主题角色（0..13，编号跨版本稳定，只准末尾追加）：
//   0 BG        面板 / BOX 背景          1 BORDER    细边框
//   2 TEXT      文本                     3 TEXT_DIS  禁用态文本
//   4 BTN       按钮 普通                5 BTN_HOVER 按钮 悬停
//   6 BTN_DOWN  按钮 按下                7 BTN_DIS   按钮 禁用
//   8 CHECK_BG  勾选框 / Radio / TextBox 底
//   9 MARK      勾 / 焦点边框 / 光标 / 高亮 / 选中点
//  10 SEL       TextBox 选区背景
//  11 TRACK     Slider / Progress 轨道底
//  12 FILL      Slider 已填充 / Progress 进度
//  13 KNOB      Slider 滑块
//
// Fail-Fast（§20）：role 越界 / 颜色高 32 位非 0 / value 越界 / 值域倒置
// 一律返回 -1 并写错误槽，绝不静默截断，绝不把非法值当成合法角色。
// set_range(lo, hi) 要求 lo <= hi；成功后把已有 value clamp 进新值域
// （getter 立刻可读回，不是不可见损坏）。默认值域 0..100。
// 新增三种控件的绘制几何：RADIO 圆圈半径 clamp 到 [4,10]；SLIDER 轨道
// 内边距 4px、轨道高 6px、滑块半径 6；PROGRESS 内边距 2px。全部纯整数，
// 与自研光栅化器同一套坐标，三平台逐像素一致。

/// 主题颜色角色数量（当前 14；新增角色只准末尾追加）。
extern fn dial_gui_theme_role_count(): int;

/// 读取某个角色的当前颜色（0..0xFFFFFFFF）；非法 role 返回 -1。
extern fn dial_gui_theme_get(role: int): int;

/// 覆写某个角色的颜色（0xAARRGGBB packed 进 int，高 32 位必须为 0）；
/// 非法 role / 颜色返回 -1 并写错误槽；返回 0 表示成功。
extern fn dial_gui_theme_set(role: int, color: int): int;

/// 把所有角色逐值复位到内置默认主题（逐像素 CRC 回到历史基准）。返回 0。
extern fn dial_gui_theme_reset(): int;

/// SLIDER / PROGRESS 当前值（默认 0）；恒落在 [vmin, vmax] 内。
extern fn dial_gui_widget_value(w: GuiWidget): int;

/// 显式设置当前值；越出 [vmin, vmax] **明确返回 -1**，绝不静默 clamp。
extern fn dial_gui_widget_set_value(w: GuiWidget, v: int): int;

/// 设置值域 [lo, hi]：要求 lo <= hi，否则返回 -1；成功后把已有 value
/// clamp 进新值域（可读回）。默认值域 0..100。
extern fn dial_gui_widget_set_range(w: GuiWidget, lo: int, hi: int): int;

/// 读取值域下界 / 上界。
extern fn dial_gui_widget_min(w: GuiWidget): int;
extern fn dial_gui_widget_max(w: GuiWidget): int;

/// RADIO 组号（0 = 未分组 / 各自独立；非 0 时同组 RELEASE 互斥）。
extern fn dial_gui_widget_set_group(w: GuiWidget, g: int): int;
extern fn dial_gui_widget_group(w: GuiWidget): int;

// ---- 第 6 层：信号槽 / 控件事件订阅（本段 10 个追加 extern fn）------------
//
// 立场：与前五层宪法完全一致 —— 纯 C、零平台符号、**绝不 C → Dial 反向回调**、
// 只追加 extern fn。「信号槽」在这里落地为**可订阅的纯值信号队列**，而不是
// C 侧注册函数指针：C 只在「语义状态真的变化」处把一条纯值信号压进每棵树
// 的环形队列，Dial 侧主动 pending → data(ptr_cast 读) → pop 消费并自行分派。
// C 管 C 的，ARC 管 ARC 的，谁也不越界，零隐式开销、零回调线程风险。
//
// 信号块 GuiWidgetSignal（72 字节，packed，100% 纯值 / 零指针 / 零句柄）：
//   int seq, signal, tag, userdata, kind, a, b, x, y   // 9 × 8 字节
//   @0 seq 单调递增序号（clear 不重置）  @8 signal 信号位值
//   @16 tag / @24 userdata 是发出控件的**纯值键**（Dial 侧自建 map 定位）
//   @32 kind 控件种类  @40 a 主值  @48 b 副值  @56 x / @64 y 事件坐标
// 块里连控件句柄都不存：控件被摘除 / 文本被覆盖 / 整树被释放之后，已入队
// 信号仍是自洽的整数快照，读数绝不悬垂，也不需要 string_from_cstr 复制。
// 布局由 C 侧 _Static_assert 与 Dial 侧 sizeof/offsetof 编译期内建双向锁死。
//
// 信号码（位值，可组合成订阅掩码；编号跨版本稳定，只准末尾追加新位）：
//   1  CLICKED        BUTTON RELEASE 激活             a=1      b=0
//   2  TOGGLED        CHECKBOX 翻转 / RADIO 选中 /     a=新checked b=旧checked
//                     widget_set_checked
//   4  TEXT_CHANGED   TEXTBOX 编辑成功 / widget_set_text a=新字节数 b=旧字节数
//   8  VALUE_CHANGED  SLIDER 设值 / widget_set_value    a=新值   b=旧值
//   16 FOCUS_CHANGED  焦点迁移（点击 / Tab / set_focus） a=1获得/0失去 b=0
//   32 SUBMITTED      TEXTBOX Enter 提交 / 对话框按钮点击 a=结果码 b=0
//   64 SELECTED       菜单项被点击选中（第 7 层）       a=item id b=0
//                     kind = GUI_WIDGET_MENU(8) / DIALOG(9) 区分来源，
//                     tag / userdata 为菜单 / 对话框的纯值键
// 每个信号只由状态**真的变化**的那一次交互 / setter 触发一次；同值 setter、
// 同组 RADIO 被动清除、set_range 的 clamp 都不另发信号（如实标注边界）。
//
// 订阅是**每控件一个 int64 掩码**：默认 0 = 不订阅 = 零开销。emit 第一行就查
// 掩码，未订阅直接返回——不找根、不分配、不入队，所以不调用 subscribe 的旧
// 程序行为 / 绘制 CRC / 函数返回值逐字节不变（历史断言不漂移）。
//
// 队列是**每树一份**（只挂根节点）：容量 GUI_SIGNAL_CAP = 64，首次 emit 时
// 按需 calloc。满则覆盖最旧、保留最新，并把根上 sig_dropped +1；Dial 侧用
// signal_dropped 读「漏了多少条」，绝不静默损坏（§20 Fail-Fast 口径）。

/// 信号种类总数（当前 7；新增信号只准末尾追加新位）。
extern fn dial_gui_signal_count(): int;

/// 每树环形队列容量（当前 64）。用于容量 / 溢出断言。
extern fn dial_gui_signal_capacity(): int;

/// 覆盖式设置控件的订阅掩码：0 = 取消全部订阅；传 GUI_SIG_* 位值的按位或
/// 组合可一次订阅多类信号。非法值（负数 / 含未知位 / 超出 0..63）明确返回
/// -1 并写错误槽，绝不静默截断。
extern fn dial_gui_widget_subscribe(w: GuiWidget, mask: int): int;

/// 读取控件当前的订阅掩码（默认 0）。
extern fn dial_gui_widget_subscribed(w: GuiWidget): int;

/// 清空订阅掩码（等价 subscribe(w, 0)）。返回 0 成功 / -1 空句柄。
extern fn dial_gui_widget_unsubscribe(w: GuiWidget): int;

/// 队列中待消费的信号条数（0..64）。root 传树内任意节点都按根处理。
extern fn dial_gui_widget_signal_pending(root: GuiWidget): int;

/// 返回队首 **72 字节纯值块** 的地址（C 侧借用，rawptr<byte>）；空队列返回
/// NULL（用 is_null 判断）。Dial 侧声明同布局 packed extern struct 后
/// ptr_cast 读取 9 个 int 字段。有效期至下次 emit / pop / clear / 树释放：
/// 必须**立即读完**再 pop，绝不长期持有（纯值无悬垂，但复用后会脏读）。
extern fn dial_gui_widget_signal_data(root: GuiWidget): rawptr<byte>;

/// 弹出队首信号：返回 1 = 确实弹出一条 / 0 = 队列本空（正常态，不算错误）。
/// 典型消费循环：while (signal_pending(root) > 0) { 读 signal_data(root);
/// signal_pop(root); }。
extern fn dial_gui_widget_signal_pop(root: GuiWidget): int;

/// 清空整树信号队列（seq 序号不重置，便于 Dial 侧检测跳号）。返回 0 / -1。
extern fn dial_gui_widget_signal_clear(root: GuiWidget): int;

/// 本树累计「队列溢出 / 分配失败」导致的信号丢弃数。Dial 侧可断言它始终
/// 为 0 来证明消费及时；非零即明确知道漏了信号，绝不静默损坏。
extern fn dial_gui_widget_signal_dropped(root: GuiWidget): int;

// ---- 第 7 层：菜单 / 对话框（本段 24 个追加 extern fn）------------------
//
// 立场：与前六层宪法完全一致 —— 纯 C、零平台符号、**绝不 C → Dial 反向回调**、
// 只追加 extern fn。菜单 / 对话框是**窗口级覆盖层**（挂在 GuiWindow 上，不进
// 控件树），因此控件几何 / 绘制 CRC 逐字节不漂移。
//
// 关键事实（防漂移）：
//   - 顶栏菜单占用窗口顶部 **GUI_MENU_BAR_H = 22** 像素；应用自行在控件树顶部
//     留白（首个子节点给 22px 垫片），覆盖层不再对它做位移。
//   - 菜单项 / 对话框按钮的选中事件**复用第 6 层信号队列**：菜单项点击发
//     GUI_SIG_SELECTED（a = item id，kind = 8 MENU，tag/userdata = 菜单的）；
//     对话框按钮点击发 GUI_SIG_SUBMITTED（a = 结果码 1/2/4/8，kind = 9 DIALOG）。
//     两者都进 **win->root 的控件树队列**，故要求窗口先 dial_gui_window_set_root。
//   - 所有权：传给 set_menubar / popup_menu / dialog_show 的菜单 / 对话框由窗口
//     在关闭时释放，调用方不要再 free；纯内存对象（未挂窗）用 menu_free /
//     dialog_free 释放，可在无 DISPLAY 环境单元测试。
//   - 统一入口：dial_gui_window_draw 一次画 控件树 + 顶栏 + 弹窗 + 对话框；
//     dial_gui_window_handle 菜单/对话框优先，否则委派 widget_handle（旧行为不变）。
//
// 对话框按钮位（dial_gui_dialog_set_buttons 的 mask，按位或）：
//   1 GUI_DLG_OK=1   2 GUI_DLG_CANCEL=2   4 GUI_DLG_YES=4   8 GUI_DLG_NO=8
// 点击后 dial_gui_dialog_result 返回被点按钮对应的值（1/2/4/8），未点为 -1。

// ---- 菜单（GuiMenu，纯内存对象，无窗口）-------------------------------

/// 菜单类型（不透明）。一个菜单是若干「项（id + label）/ 分隔符」的序列。
type GuiMenu;

/// 新建空菜单（不含任何项）。失败返回空句柄。用完若未挂窗须 dial_gui_menu_free。
extern fn dial_gui_menu_new(): GuiMenu;

/// 释放菜单及其所有项（仅用于未挂窗的纯内存菜单）。已 set_menubar / popup_menu
/// 的菜单所有权归窗口，由窗口关闭时释放，调用方不要再 free。返回 0 / -1。
extern fn dial_gui_menu_free(m: GuiMenu): int;

/// 追加一个菜单项：id 是纯值键（SELECTED 信号的 a），label 为显示文本。返回 0 / -1。
extern fn dial_gui_menu_add_item(m: GuiMenu, id: int, label: string): int;

/// 追加一条分隔符（绘制为横线，不可命中、不产生信号）。返回 0 / -1。
extern fn dial_gui_menu_add_sep(m: GuiMenu): int;

/// 设置菜单的 tag 纯值键（SELECTED 信号会带出）。返回 0 / -1。
extern fn dial_gui_menu_set_tag(m: GuiMenu, tag: int): int;
extern fn dial_gui_menu_tag(m: GuiMenu): int;

/// 菜单项总数（含分隔符）。
extern fn dial_gui_menu_count(m: GuiMenu): int;

/// 按序（0 = 最先 add_item 的项）读第 idx 项的 id；越界返回 -1 并写错误槽。
extern fn dial_gui_menu_item_id(m: GuiMenu, idx: int): int;
/// 按序读第 idx 项的 label 的 **C 侧借用指针**（const char*）；所有权在 C，
/// 必须立刻 string_from_cstr 复制成 ARC string，绝不长期持有。越界返回空串。
extern fn dial_gui_menu_item_label(m: GuiMenu, idx: int): rawptr<byte>;
/// 启用 / 禁用第 idx 项（禁用项不可命中、不产生信号）；越界返回 -1。
extern fn dial_gui_menu_item_set_enabled(m: GuiMenu, idx: int, v: int): int;

// ---- 顶栏菜单 / 弹出菜单（窗口级，所有权转移给窗口）--------------------

/// 把菜单挂为窗口顶栏（左→右排布，恒展开）。要求窗口先 set_root，否则 -1。
/// 替换旧顶栏（旧顶栏由窗口释放）；空菜单 / 重复挂同一菜单安全。返回 0 / -1。
extern fn dial_gui_window_set_menubar(win: GuiWindow, m: GuiMenu): int;

/// 在窗口内 (x,y) 处弹出一个菜单（覆盖层，点击项或外部关闭即消失）。
/// 要求窗口先 set_root，否则 -1。弹出菜单的所有权归窗口：选中 / 外部点击
/// 关闭后由窗口释放，调用方不要再 free。返回 0 / -1。
extern fn dial_gui_window_popup_menu(win: GuiWindow, m: GuiMenu, x: int, y: int): int;

/// 关闭当前弹出菜单（若有）。返回 0 成功。
extern fn dial_gui_window_close_popup(win: GuiWindow): int;

// ---- 对话框（GuiDialog，纯内存对象，无窗口）---------------------------

/// 对话框类型（不透明）。典型的「标题 + 消息 + 按钮」模态覆盖层。
type GuiDialog;

/// 新建对话框（result 初值 -1，未展开）。失败返回空句柄。用完若未挂窗须 dialog_free。
extern fn dial_gui_dialog_new(): GuiDialog;
/// 释放对话框（仅用于未挂窗的纯内存对话框）。已 dialog_show 的对话框所有权归
/// 窗口，由窗口关闭时释放，调用方不要再 free。返回 0 / -1。
extern fn dial_gui_dialog_free(d: GuiDialog): int;

/// 设置对话框标题 / 消息文本（C 侧 strdup 自有副本）。返回 0 / -1。
extern fn dial_gui_dialog_set_title(d: GuiDialog, title: string): int;
extern fn dial_gui_dialog_set_message(d: GuiDialog, msg: string): int;

/// 设置按钮掩码（GUI_DLG_OK=1 / CANCEL=2 / YES=4 / NO=8 的按位或）；
/// 未知位 / 负数返回 -1。至少须有一个按钮，否则 show 无意义。
extern fn dial_gui_dialog_set_buttons(d: GuiDialog, mask: int): int;

/// 把对话框挂到窗口并显示（模态：点击外部忽略，仅按钮可选）。
/// 要求窗口先 set_root，否则 -1。所有权归窗口；重复 show 同一对话框安全。
/// 每次 show 把 result 复位为 -1、open 置 1。返回 0 / -1。
extern fn dial_gui_dialog_show(win: GuiWindow, d: GuiDialog): int;

/// 隐藏当前对话框（open 置 0，对象仍归窗口保留，可再次 show）。返回 0 成功。
extern fn dial_gui_dialog_hide(win: GuiWindow): int;

/// 读取对话框最近一次点击的结果码（1 OK / 2 CANCEL / 4 YES / 8 NO）；
/// 尚未点击任何按钮返回 -1。空句柄返回 -1。
extern fn dial_gui_dialog_result(d: GuiDialog): int;

/// 对话框当前是否展开显示（1 / 0）。空句柄返回 0。
extern fn dial_gui_dialog_open(d: GuiDialog): int;

// ---- 窗口级统一绘制 + 事件分发 -----------------------------------------

/// 把窗口一次性画全：先背景铺底，再控件树，最后叠加顶栏菜单 + 弹出菜单 +
/// 对话框覆盖层。须在 set_root 后使用（覆盖层绘制依赖窗口画布）。返回 0 / -1。
extern fn dial_gui_window_draw(win: GuiWindow): int;

/// 把一条事件喂给窗口：菜单 / 对话框覆盖层优先处理（命中即发信号并 return 3），
/// 否则委派 dial_gui_widget_handle 走控件树（旧行为不变）。kind 用事件码
/// （1 PRESS / 2 RELEASE / 3 MOUSE_MOVE），x/y 客户区坐标，button 鼠标键（1 左键）。
/// 返回 3 = 本次菜单/对话框激活 / 1 = 控件激活 / 0 = 无激活 / -1 = 参数错误。
extern fn dial_gui_window_handle(win: GuiWindow, kind: int, x: int, y: int, button: int): int;

// ---- 第 9 层：滚动视图（本段 15 个追加 extern fn）-----------------------
//
// 立场：与前七层 / 第 7 层菜单对话框完全一致 —— 纯 C、零平台符号、绝不 C → Dial
// 反向回调、只追加 extern fn。滚动视图是**窗口级辅助覆盖层**（挂在 GuiWindow
// 上，不进控件树），让内容大于视口的控件树可滚动浏览。
//
// 关键事实（防漂移）：
//   - 视口裁剪由调用方在绘制时按 off_x/off_y 平移内容并 dial_gui_set_clip
//     （本层不碰 painter）；滚动条绘制走 gui_raster_*，几何 / 绘制 CRC 逐字节不漂移。
//   - 偏移是纯值：由 Dial 侧主动 scroll_to / wheel / drag 推进，再用
//     offset_x / offset_y 读回；越界自动夹紧到 [0, 内容-视口]。
//   - which 约定：0 = 水平滚动条，1 = 垂直滚动条（与 enable 的掩码位一致）。
//   - 命中（hit）返回 0 未命中 / 1 命中滑块 / 2 命中轨道；应用据返回值管理拖拽
//     flag，拖拽中每帧调 drag(x, y, which) 让滑块中心跟随鼠标（纯几何换算）。
//   - 所有权：未挂窗的纯内存对象用 scroll_free 释放，可在无 DISPLAY 环境单元测试；
//     挂窗对象由窗口关闭时一并释放，调用方不要再 free。

// ---- 滚动视图对象（GuiScroll，纯内存对象，无窗口）----------------------

/// 滚动视图类型（不透明）。一个滚动视图绑定一个视口 + 一块内容，维护偏移。
type GuiScroll;

/// 新建空滚动视图（视口 / 内容均为 0，偏移 0，bar_size=10）。失败返回空句柄。
/// 用完若未挂窗须 dial_gui_scroll_free。
extern fn dial_gui_scroll_new(): GuiScroll;

/// 释放滚动视图（纯内存对象）。已挂窗的对象由窗口关闭时一并释放，不要再 free。
extern fn dial_gui_scroll_free(s: GuiScroll): int;

/// 设置视口矩形（窗口内坐标 + 尺寸，尺寸须为正）。返回 0 / -1（Fail-Fast）。
extern fn dial_gui_scroll_set_viewport(s: GuiScroll, x: int, y: int, w: int, h: int): int;

/// 设置内容总尺寸（须为正）。返回 0 / -1（Fail-Fast）。
extern fn dial_gui_scroll_set_content(s: GuiScroll, w: int, h: int): int;

/// 启用 / 禁用某方向滚动：which 0=水平 / 1=垂直 / 2=两者，on 非 0 即启用。
/// 返回 0 / -1（Fail-Fast 越界）。
extern fn dial_gui_scroll_enable(s: GuiScroll, which: int, on: int): int;

/// 设置 / 读取用户 tag（64 位，可 round-trip，与 GuiMenu.tag 同宽）。
extern fn dial_gui_scroll_set_tag(s: GuiScroll, tag: int): int;
extern fn dial_gui_scroll_tag(s: GuiScroll): int;

/// 读取当前偏移（已夹紧）。空句柄返回 0。
extern fn dial_gui_scroll_offset_x(s: GuiScroll): int;
extern fn dial_gui_scroll_offset_y(s: GuiScroll): int;

/// 直接设置偏移（越界夹紧到 [0, 内容-视口]）。返回 0 / -1。
extern fn dial_gui_scroll_scroll_to(s: GuiScroll, x: int, y: int): int;

/// 滚轮推进（dy>0 向下滚）。返回新的 off_y（已夹紧）。空句柄返回 0。
extern fn dial_gui_scroll_wheel(s: GuiScroll, dy: int): int;

/// 命中测试：which 0=水平 / 1=垂直。返回 0 未命中 / 1 命中滑块 / 2 命中轨道
/// （须该方向已启用且内容大于视口，否则直接 0）。
extern fn dial_gui_scroll_hit(s: GuiScroll, x: int, y: int, which: int): int;

/// 拖拽推进：按 (x, y) 让 which 方向滑块中心跟随鼠标（纯几何换算，越界夹紧）。
/// 返回新的 off_y（which=1）/ off_x（which=0）。空句柄或 which 越界返回当前值。
extern fn dial_gui_scroll_drag(s: GuiScroll, x: int, y: int, which: int): int;

/// 设置滚动条厚度（须 >= 10）。返回 0 / -1（Fail-Fast 过小）。
extern fn dial_gui_scroll_set_bar_size(s: GuiScroll, sz: int): int;

/// 绘制某方向滚动条（轨道 + 滑块，主题色）。须该方向已启用且内容大于视口，
/// 否则返回 0（不绘制）。空句柄返回 -1。p 为窗口画布。
extern fn dial_gui_scroll_draw_bar(p: GuiPainter, s: GuiScroll, which: int): int;

