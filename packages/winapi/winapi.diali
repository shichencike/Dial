// winapi.dialpkg —— Windows API 薄封装（kernel32 / user32 / gdi32 代表函数），
// Dial 语言接口签名。
//
// 设计立场（详见 packages/winapi/src/winapi_impl.c 与 README）：
//   - 这是一层**薄封装**：Win32 函数名与参数名**一个都不改**，原样暴露给 Dial；
//     C 侧只做「装载 + 调用 + 错误码搬运」，不重写任何 Win32 语义。
//   - 平台库一律**运行时 LoadLibraryA / GetProcAddress 动态装载**：.a 自包含，
//     Dial 侧不需要写 link，链接期也不需要 -luser32 / -lgdi32；缺库返回明确错误码
//     + 最近错误槽，绝不静默崩溃（与 gui 包同口径）。
//   - kernel32 的装载器（LoadLibraryA / GetProcAddress）直接链接（Windows 上
//     kernel32 总是已加载）；user32 / gdi32 的函数全部运行时解析，零链接期符号依赖。
//   - W 系列函数（MessageBoxW / CreateWindowExW / ...）收 UTF-16：C 侧把 Dial 的
//     UTF-8 string 转成 UTF-16LE 再调用；A 系列（LoadLibraryA）直接传 UTF-8 字节。
//   - 句柄（HWND / HMODULE / HDC / ...）映射为 Dial 不透明类型，跨 FFI 按指针编组；
//     BOOL / DWORD / LRESULT / WPARAM / LPARAM 一律映射 Dial int（64 位，
//     足够容纳 32/64 位值，上 32 位为 0）。
//   - 错误走返回码 + 最近错误槽（winapi_last_error / winapi_last_error_msg），
//     不抛 Dial 异常；句柄不进 ARC，语义与 Win32 一致（调用方负责 CloseHandle 等）。
//
// 平台行为：
//   - Windows（x86_64-pc-windows-gnu）：真实现，调用落进真实 user32 / gdi32 / kernel32。
//   - 其他平台（Linux / musl）：桩实现，每个函数返回 -1（句柄类返回 0）并把错误槽
//     置为 WINAPI_ERR_PLATFORM，明确告知「本平台不支持」——而不是让链接失败。
//     这是诚实的「后端不可用」信号，与 gui 的 GUI_ERR_NO_BACKEND 同哲学。
//
// 已封装范围（首批代表集，覆盖三核心 DLL 的输入 / 输出：句柄、整数、字符串）：
//   1) kernel32（11）：模块装载 / 错误槽 / 进程线程 id / 计时 / 睡眠 / 退出；
//   2) user32（13）：消息框 / 窗口创建销毁 / 显示更新 / 消息循环 / 消息发送 /
//      查找 / 标题 / 移动 / 置前；
//   3) gdi32（9）：设备上下文 / 文本输出 / 矩形椭圆 / 画刷 / 图元对象 / 直线。
// 一律只追加 extern fn：旧签名一字不动，abi = 6 / version = 1.10.0 不变。
//
// 仍未实现、因此**不写进本契约**（薄封装扩展批次，非预留接口）：
//   - 需要调用方分配输出缓冲区的 API（如 GetWindowTextW 的 lpString 出参）；
//   - 结构体参数 API（如 RegisterClassW / WNDCLASS、PAINTSTRUCT、MSG）；
//   - 其余 DLL（advapi32 / shell32 / comctl32 / ole32 / d2d1 / ...）与全量 Win32 表面。
// 把未实现的函数写进 .diali 会让用户 import 后链接失败，那是制造漂移而非预留接口。

/// 最近错误码（不透明整数，见 winapi_last_error）。
type HWnd;
/// 模块句柄（LoadLibraryA / GetModuleHandleW 返回值）。
type HModule;
/// 实例句柄（CreateWindowExW 的 hInstance 参数）。
type HInstance;
/// 设备上下文（GetDC / ReleaseDC 返回值）。
type HDC;
/// GDI 画刷（CreateSolidBrush 返回值）。
type HBrush;
/// 菜单句柄（CreateWindowExW 的 hMenu 参数）。
type HMENU;
/// GDI 图元对象（DeleteObject 的参数）。
type HGDIOBJ;

/// 取最近一次错误码（跨调用覆盖，语义同 GetLastError 的作用域）。
/// WINAPI_ERR_PLATFORM=1 表示当前平台不支持（桩返回）；WINAPI_ERR_LOAD=3 表示
/// DLL / 函数装载失败；WINAPI_ERR_ARG=2 表示空句柄 / 非法参数。
extern fn winapi_last_error(): int;
/// 取最近一次错误的人类可读描述（借用 C 串，Dial 侧必须 string_from_cstr 复制成 ARC 对象）。
extern fn winapi_last_error_msg(): rawptr<byte>;

// ---- 空句柄构造器（Dial 侧 FFI 粘合层，非 Win32 函数）----------------------
// 真实 Win32 程序常把 NULL 传给某些句柄参数（如 CreateWindowExW 的 hMenu /
// hInstance、DeleteObject 的 HGDIOBJ）；Dial 的不透明句柄类型严格禁止用字面量 0
// 冒充，包内也没有返回这三类句柄的 Win32 函数，故提供类型安全的空句柄构造器
// （一律返回 (void*)0）。与 winapi_last_error / winapi_last_error_msg 同属「包装之外的
// 必要粘合」，不属于薄封装的 Win32 表面，因此不计入「函数名参数原样」的承诺。
/// 取空 HMENU 句柄（CreateWindowExW 的 hMenu 参数常传 NULL）。返回类型安全的空句柄。
extern fn winapi_null_hmenu(): HMENU;
/// 取空 HINSTANCE 句柄（CreateWindowExW 的 hInstance 参数常传 NULL / 或来自 WinMain）。
extern fn winapi_null_hinstance(): HInstance;
/// 取空 HGDIOBJ 句柄（DeleteObject 可传任意 GDI 对象；无对象时传 NULL）。
extern fn winapi_null_hgdiobj(): HGDIOBJ;

// ---- kernel32（11）---------------------------------------------------------
/// 取已加载模块的句柄（lpModuleName 传 "" 取当前 EXE 自身）。返回 HModule，失败返回 0。
extern fn GetModuleHandleW(lpModuleName: string): HModule;
/// 动态装载 DLL（A 版收 UTF-8 模块名）。返回 HModule，失败返回 0。
extern fn LoadLibraryA(lpLibFileName: string): HModule;
/// 释放 LoadLibraryA 装载的模块。返回 1 成功、0 失败。
extern fn FreeLibrary(hLibModule: HModule): int;
/// 按名取模块导出函数地址（lpProcName 为函数名 C 串）。返回函数指针（rawptr<byte>），失败返回 0。
extern fn GetProcAddress(hModule: HModule, lpProcName: string): rawptr<byte>;
/// 取最近一次系统错误码（与 winapi_last_error 不同作用域：这是 Win32 原生错误码）。
extern fn GetLastError(): int;
/// 设置 Win32 原生错误码（供仿真 / 测试）。
extern fn SetLastError(dwErrCode: int): int;
/// 挂起当前线程 dwMilliseconds 毫秒（Win32 原生睡眠）。返回 0。
extern fn Sleep(dwMilliseconds: int): int;
/// 终止当前进程并返回 uExitCode（不返回）。
extern fn ExitProcess(uExitCode: int): int;
/// 取当前进程 id。
extern fn GetCurrentProcessId(): int;
/// 取当前线程 id。
extern fn GetCurrentThreadId(): int;
/// 取系统启动以来的毫秒数（32 位回绕，Dial 侧按 int 读）。
extern fn GetTickCount(): int;

// ---- user32（13）---------------------------------------------------------
/// 弹出一个模态消息框（W 版收 UTF-16，C 侧把 text/caption 的 UTF-8 转 UTF-16）。
/// 返回 IDOK/IDCANCEL 等按钮 id，失败返回 -1。
extern fn MessageBoxW(hWnd: HWnd, text: string, caption: string, uType: int): int;
/// 创建重叠 / 弹出 / 子窗口（W 版收 UTF-16 类名与标题）。返回 HWnd，失败返回 0。
extern fn CreateWindowExW(dwExStyle: int, lpClassName: string, lpWindowName: string, dwStyle: int, x: int, y: int, nWidth: int, nHeight: int, hWndParent: HWnd, hMenu: HMENU, hInstance: HInstance, lpParam: rawptr<byte>): HWnd;
/// 销毁窗口。返回 1 成功、0 失败。
extern fn DestroyWindow(hWnd: HWnd): int;
/// 设置窗口显示状态（nCmdShow：SW_HIDE=0 / SW_SHOW=5 / ...）。返回原显示状态（BOOL）。
extern fn ShowWindow(hWnd: HWnd, nCmdShow: int): int;
/// 向窗口过程发 WM_PAINT（若无效区非空）。返回 1 成功、0 失败。
extern fn UpdateWindow(hWnd: HWnd): int;
/// 向消息循环投递退出码（触发 WM_QUIT）。返回 0。
extern fn PostQuitMessage(nExitCode: int): int;
/// 默认窗口过程（窗口过程未处理消息的兜底分发）。返回 LRESULT（int）。
extern fn DefWindowProcW(hWnd: HWnd, Msg: int, wParam: int, lParam: int): int;
/// 向窗口发送消息并等待处理完成（同步）。返回 LRESULT（int）。
extern fn SendMessageW(hWnd: HWnd, Msg: int, wParam: int, lParam: int): int;
/// 向窗口投递消息（异步，入队即返回）。返回 1 成功、0 失败。
extern fn PostMessageW(hWnd: HWnd, Msg: int, wParam: int, lParam: int): int;
/// 按类名 / 标题查找顶层窗口（W 版收 UTF-16）。返回 HWnd，未找到返回 0。
extern fn FindWindowW(lpClassName: string, lpWindowName: string): HWnd;
/// 设置窗口标题（W 版收 UTF-16）。返回 1 成功、0 失败。
extern fn SetWindowTextW(hWnd: HWnd, lpString: string): int;
/// 移动 / 缩放窗口（bRepaint 非 0 触发重绘）。返回 1 成功、0 失败。
extern fn MoveWindow(hWnd: HWnd, x: int, y: int, nWidth: int, nHeight: int, bRepaint: int): int;
/// 把窗口提到 Z 序顶部并激活。返回 1 成功、0 失败。
extern fn SetForegroundWindow(hWnd: HWnd): int;

// ---- gdi32（9）-----------------------------------------------------------
/// 取窗口客户区设备上下文（绘制前必取，绘制后须 ReleaseDC）。返回 HDC，失败返回 0。
extern fn GetDC(hWnd: HWnd): HDC;
/// 释放 GetDC 取得的设备上下文。返回 1 成功、0 失败。
extern fn ReleaseDC(hWnd: HWnd, hDC: HDC): int;
/// 在设备上下文输出文本（W 版收 UTF-16）。返回 1 成功、0 失败。
extern fn TextOutW(hDC: HDC, x: int, y: int, lpString: string, c: int): int;
/// 绘制矩形（使用当前画笔 / 画刷）。返回 1 成功、0 失败。
extern fn Rectangle(hDC: HDC, left: int, top: int, right: int, bottom: int): int;
/// 绘制椭圆（外接矩形 left/top/right/bottom）。返回 1 成功、0 失败。
extern fn Ellipse(hDC: HDC, left: int, top: int, right: int, bottom: int): int;
/// 创建实心画刷（crColor 为 0x00BBGGRR 打包 int）。返回 HBrush，失败返回 0。
extern fn CreateSolidBrush(crColor: int): HBrush;
/// 删除 GDI 图元对象（画刷 / 笔 / 位图等）。返回 1 成功、0 失败。
extern fn DeleteObject(hObject: HGDIOBJ): int;
/// 把当前点移到 (x, y)（lpPoint 传 0 表示不要前一点）。返回 1 成功、0 失败。
extern fn MoveToEx(hDC: HDC, x: int, y: int, lpPoint: rawptr<byte>): int;
/// 从当前点画线到 (x, y)。返回 1 成功、0 失败。
extern fn LineTo(hDC: HDC, x: int, y: int): int;
