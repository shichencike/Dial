// v1.04 第 3 批 B6：结构体进容器（Point[] / map<string, Struct>）
// B6a（数组）：值类型结构体按值装不进 8 字节槽，故装箱为 RC 对象后入槽。
// 测试点：
//   1) 结构体数组字面量 + length
//   2) 下标读出字段（解箱按值）
//   3) 绑定到变量后读字段
//   4) push / set 下标写（重新装箱）
//   5) 元素类型白名单：含句柄字段的结构体被明确拒绝（负向见 tests/bad）

struct Point {
    x: int = 0,
    y: int = 0,
}

fn main(): int {
    var pts: Point[] = [Point{x: 1, y: 2}, Point{x: 3, y: 4}];
    print("B6 len = ", pts.length());
    print("B6 p0.x = ", pts[0].x);
    print("B6 p0.y = ", pts[0].y);
    print("B6 p1.x = ", pts[1].x);

    var q: Point = pts[1];
    print("B6 q.x = ", q.x);
    print("B6 q.y = ", q.y);

    pts[0] = Point{x: 9, y: 9};
    print("B6 after write p0.x = ", pts[0].x);

    pts.set(1, Point{x: 5, y: 6});
    print("B6 after set p1.x = ", pts[1].x);

    var pts2: Point[] = [];
    pts2.push(Point{x: 7, y: 8});
    print("B6 pts2 len = ", pts2.length());
    print("B6 pts2[0].x = ", pts2[0].x);

    // B6b：map<string, Struct>——结构体作 map 值
    var m: map<string, Point> = new_kv_map();
    m.put("a", Point{x: 1, y: 2});
    m.put("b", Point{x: 3, y: 4});
    print("B6 map size = ", m.size());
    var hit: Point = m.get("a");
    print("B6 map hit.x = ", hit.x);
    print("B6 map hit.y = ", hit.y);
    var miss: Point = m.get("zzz");
    print("B6 map miss.x = ", miss.x);          // 未命中 → 零值结构体
    print("B6 map contains = ", m.contains("b"));
    var vals: Point[] = m.values();
    print("B6 map values len = ", vals.length());
    var def: Point = m.get_or("zzz", Point{x: 9, y: 9});
    print("B6 map get_or default.x = ", def.x);
    var def2: Point = m.get_or("b", Point{x: 9, y: 9});
    print("B6 map get_or hit.x = ", def2.x);
    var rm: Point = m.remove("a");
    print("B6 map removed.x = ", rm.x);
    print("B6 map size after remove = ", m.size());
    return 0;
}
