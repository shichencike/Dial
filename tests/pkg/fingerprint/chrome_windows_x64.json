  "exemptions": [
    {
      "name": "ech_hpke",
      "detail": "ECH 扩展只发哑占位，不实现 HPKE 加密；JA4 只看扩展 id，集合已对齐。"
    },
    {
      "name": "certificate_compression",
      "detail": "001b 只发哑占位，不实现 brotli 解压；发而不能解压会破坏握手，故不发真实支持列表。"
    },
    {
      "name": "multi_key_share",
      "detail": "真·多组 key_share 不做；仅 X25519 一组 + GREASE 哑条目（纯字节编排）。PQC 组 11ec 只在 supported_groups 里占位。"
    },
    {
      "name": "br_zstd",
      "detail": "vendor 仅 mbedTLS+zlib，Accept-Encoding 保持 gzip, deflate；Chrome 原值 gzip, deflate, br, zstd 记为已声明降级豁免。"
    },
    {
      "name": "alps_payload",
      "detail": "ALPS(44cd) 只发哑占位，不实现应用层设置协商。"
    },
    {
      "name": "session_state",
      "detail": "session_ticket / PSK 复用 / OCSP / SCT 真实校验不发状态逻辑，仅占位。"
    },
    {
      "name": "cookie_redirect_cache",
      "detail": "cookie jar / 重定向 / 缓存条件请求 / Referer-Origin 派生属浏览器会话层，不在协议层一致性范围。"
    },
    {
      "name": "h2_priority",
      "detail": "HTTP/2 PRIORITY / 依赖树 Chrome 已弃用（转 RFC 9218），不做。"
    },
    {
      "name": "byte_identical",
      "detail": "ClientHello 含 random / key_share 临时公钥 / GREASE / ECH 密文，两次真 Chrome 亦不同；明确不追求逐字节一致。"
    }
  ],
