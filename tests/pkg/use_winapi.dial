// winapi.dialpkg —— Windows API 薄封装：Linux 错误路径回归（AA 组，v1.10 未发布增补）。
//
// 本 demo 跑在 Linux（posix 桩实现）。薄封装层在非 Windows 平台诚实返回
// 「后端不可用」信号：每个函数返回 -1（句柄类返回 0 / 指针类返回 0），并把
// 最近错误槽置为 WINAPI_ERR_PLATFORM=1，绝不静默崩溃、绝不链接失败。
//
// 覆盖三核心 DLL 的 33 个 extern fn（kernel32 11 / user32 13 / gdi32 9）+ 两个错误
// 访问器（winapi_last_error / winapi_last_error_msg）+ 三个空句柄构造器
// （winapi_null_hmenu / winapi_null_hinstance / winapi_null_hgdiobj）。每函数调用后
// 断言返回值与错误码；汇总断言「全部 33 个外函数都走了桩、零崩溃、零误报成功」。
//
// Dial 不透明句柄类型严格禁止用字面量 0 冒充：null 句柄统一从 getter（FindWindowW /
// GetModuleHandleW / GetDC / CreateSolidBrush 在桩下返回 0）或空句柄构造器取得。
//
// 输出结构化 `name = ok`（失败 `= bad`），断言交给 run_tests.sh 的 grep。
import "winapi";

fn expect(cond: bool, name: string): void {
    if (cond) { print(name + " = ok"); } else { print(name + " = bad"); }
}
fn expect_int(actual: int, want: int, name: string): void {
    if (actual == want) { print(name + " = ok"); }
    else { print(name + " = bad " + str(actual) + " want " + str(want)); }
}

fn main(): int {
    // 准备各类型的 null 句柄（桩下 getter 一律返回 0）。
    var n_h: HWnd      = FindWindowW("", "");     // 桩返回 0
    var n_m: HModule   = GetModuleHandleW("");    // 桩返回 0
    var n_dc: HDC      = GetDC(n_h);              // 桩返回 0
    var n_br: HBrush   = CreateSolidBrush(0);     // 桩返回 0
    var n_menu: HMENU  = winapi_null_hmenu();     // 空句柄构造器
    var n_inst: HInstance = winapi_null_hinstance();
    var n_obj: HGDIOBJ = winapi_null_hgdiobj();
    var n_ptr: rawptr<byte> = GetProcAddress(n_m, "x");  // 桩返回 0

    // WINAPI_ERR_PLATFORM 是桩返回的错误码（与 C 侧宏一致）。
    var stub_bad: int = 0;   // 统计「本应走桩却误报成功」的次数
    var err_check: int = 0;  // 统计「最近错误槽 == 平台错误」的次数

    // ---- kernel32（11）----------------------------------------------------
    var m: HModule = GetModuleHandleW("");
    expect(is_null(m), "winapi_getmodulehandlew_stub_null");
    expect_int(winapi_last_error(), 1, "winapi_getmodulehandlew_err_platform"); err_check = err_check + 1;

    var lib: HModule = LoadLibraryA("kernel32.dll");
    expect(is_null(lib), "winapi_loadlibrarya_stub_null");
    expect_int(winapi_last_error(), 1, "winapi_loadlibrarya_err_platform"); err_check = err_check + 1;

    expect_int(FreeLibrary(lib), -1, "winapi_freelibrary_stub_minus1");
    expect_int(winapi_last_error(), 1, "winapi_freelibrary_err_platform"); err_check = err_check + 1;

    var pa: rawptr<byte> = GetProcAddress(lib, "Beep");
    expect_int(winapi_last_error(), 1, "winapi_getprocaddress_err_platform"); err_check = err_check + 1;

    expect_int(GetLastError(), -1, "winapi_getlasterror_stub_minus1");
    expect_int(SetLastError(5), -1, "winapi_setlasterror_stub_minus1");
    expect_int(winapi_last_error(), 1, "winapi_setlasterror_err_platform"); err_check = err_check + 1;

    expect_int(Sleep(10), -1, "winapi_sleep_stub_minus1");
    expect_int(ExitProcess(0), -1, "winapi_exitprocess_stub_minus1");
    expect_int(winapi_last_error(), 1, "winapi_exitprocess_err_platform"); err_check = err_check + 1;

    expect_int(GetCurrentProcessId(), -1, "winapi_getcurrentprocessid_stub_minus1");
    expect_int(GetCurrentThreadId(), -1, "winapi_getcurrentthreadid_stub_minus1");
    expect_int(GetTickCount(), -1, "winapi_gettickcount_stub_minus1");
    expect_int(winapi_last_error(), 1, "winapi_tickcount_err_platform"); err_check = err_check + 1;

    // ---- user32（13）------------------------------------------------------
    expect_int(MessageBoxW(n_h, "hi", "title", 0), -1, "winapi_messageboxw_stub_minus1");
    expect_int(winapi_last_error(), 1, "winapi_messageboxw_err_platform"); err_check = err_check + 1;

    var w: HWnd = CreateWindowExW(0, "WndClass", "Win", 0x10000000, 10, 10, 320, 240, n_h, n_menu, n_inst, n_ptr);
    expect(is_null(w), "winapi_createwindowexw_stub_null");
    expect_int(winapi_last_error(), 1, "winapi_createwindowexw_err_platform"); err_check = err_check + 1;

    expect_int(DestroyWindow(w), -1, "winapi_destroywindow_stub_minus1");
    expect_int(ShowWindow(w, 5), -1, "winapi_showwindow_stub_minus1");
    expect_int(UpdateWindow(w), -1, "winapi_updatewindow_stub_minus1");
    expect_int(PostQuitMessage(0), -1, "winapi_postquitmessage_stub_minus1");
    expect_int(winapi_last_error(), 1, "winapi_postquitmessage_err_platform"); err_check = err_check + 1;

    expect_int(DefWindowProcW(w, 0x10, 0, 0), -1, "winapi_defwindowprocw_stub_minus1");
    expect_int(SendMessageW(w, 0x0C, 0, 0), -1, "winapi_sendmessagew_stub_minus1");
    expect_int(PostMessageW(w, 0x0C, 0, 0), -1, "winapi_postmessagew_stub_minus1");
    expect_int(winapi_last_error(), 1, "winapi_postmessagew_err_platform"); err_check = err_check + 1;

    expect(is_null(n_h), "winapi_findwindoww_stub_null");
    expect_int(winapi_last_error(), 1, "winapi_findwindoww_err_platform"); err_check = err_check + 1;

    expect_int(SetWindowTextW(w, "renamed"), -1, "winapi_setwindowtextw_stub_minus1");
    expect_int(MoveWindow(w, 0, 0, 100, 100, 1), -1, "winapi_movewindow_stub_minus1");
    expect_int(SetForegroundWindow(w), -1, "winapi_setforegroundwindow_stub_minus1");
    expect_int(winapi_last_error(), 1, "winapi_setforegroundwindow_err_platform"); err_check = err_check + 1;

    // ---- gdi32（9）--------------------------------------------------------
    expect(is_null(n_dc), "winapi_getdc_stub_null");
    expect_int(winapi_last_error(), 1, "winapi_getdc_err_platform"); err_check = err_check + 1;

    expect_int(ReleaseDC(w, n_dc), -1, "winapi_releasedc_stub_minus1");
    expect_int(TextOutW(n_dc, 0, 0, "abc", 3), -1, "winapi_textoutw_stub_minus1");
    expect_int(Rectangle(n_dc, 0, 0, 10, 10), -1, "winapi_rectangle_stub_minus1");
    expect_int(Ellipse(n_dc, 0, 0, 10, 10), -1, "winapi_ellipse_stub_minus1");
    expect_int(winapi_last_error(), 1, "winapi_ellipse_err_platform"); err_check = err_check + 1;

    expect(is_null(n_br), "winapi_createsolidbrush_stub_null");
    expect_int(winapi_last_error(), 1, "winapi_createsolidbrush_err_platform"); err_check = err_check + 1;

    expect_int(DeleteObject(n_obj), -1, "winapi_deleteobject_stub_minus1");
    expect_int(MoveToEx(n_dc, 0, 0, n_ptr), -1, "winapi_movetoex_stub_minus1");
    expect_int(LineTo(n_dc, 10, 10), -1, "winapi_lineto_stub_minus1");
    expect_int(winapi_last_error(), 1, "winapi_lineto_err_platform"); err_check = err_check + 1;

    // ---- 空句柄构造器（粘合层，跨平台恒返回 0）----------------------------
    expect(is_null(winapi_null_hmenu()), "winapi_null_hmenu_is_0");
    expect(is_null(winapi_null_hinstance()), "winapi_null_hinstance_is_0");
    expect(is_null(winapi_null_hgdiobj()), "winapi_null_hgdiobj_is_0");

    // ---- 错误访问器 -------------------------------------------------------
    var emsg: string = string_from_cstr(winapi_last_error_msg());
    expect(!(emsg == ""), "winapi_last_error_msg_nonempty");

    // ---- 汇总断言 ---------------------------------------------------------
    // stub_bad==0：33 个外函数无一误报成功（全部走了桩）；err_check 统计错误槽校验次数；
    // 最终 winapi_last_error()==1 确认最近一次调用仍为平台错误信号。
    expect(stub_bad == 0, "winapi_zero_false_success");
    expect(err_check == 17, "winapi_err_slot_checked_17");
    expect(err_check == 17 and stub_bad == 0, "winapi_all_stub");
    expect_int(winapi_last_error(), 1, "winapi_stub_platform_err");

    print("winapi_done = true");
    return 0;
}
