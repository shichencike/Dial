// 内存上界回归用例：a[i] = v 的下标赋值**不得**触发 COW 深拷贝。
//
// 背景（v0.99 修复的真实缺陷）：数组运行时在「独占」路径上多做了 retain、
// 且共享路径上没释放旧引用，于是每写一次下标赋值引用计数就 +1。COW 守卫
// `refcount > 1` 从此恒真——每一次 a[i] = v 都深拷贝整个数组。
// 于是 N 次写就是 O(N^2) 内存：N=100 万需要约 8 TB，进程被 OOM Killed。
//
// 本用例在「虚拟内存上限」下运行（见 tests/run_tests.sh 的 N 组）：
// 修复后峰值约 10 MB；一旦 COW 误判复发，几 MB 的上限就会立刻把它打爆。

fn main(): int {
    let N: int = 1000000;
    var a: int[] = [0];
    for (i in 0..N) { a.push(i); }

    // 100 万次下标赋值：每次都走 a[i] = ... 这条路径
    for (i in 0..N) {
        a[i] = (a[i] * a[i] + 7) % 100003;
    }

    var sum: int = 0;
    for (i in 0..N) { sum = sum + a[i]; }
    print(sum);
    return 0;
}
