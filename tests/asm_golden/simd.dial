// M7-e3az：simd<T, N> 原生向量黄金用例。
// 覆盖：逐 lane 构造 / 广播 / 四种算术 / 六种比较（含 byte 无符号谓词）/
// lane 提取 / sizeof/alignof。llvm 与 asm 两后端输出必须逐字节一致。

fn main(): int {
    // int4：逐 lane 构造 + 广播 + 加减乘 + 按位
    var a: simd<int, 4> = simd<int, 4>(10, 20, 30, 40);
    var b: simd<int, 4> = simd<int, 4>(3);
    var add: simd<int, 4> = a + b;
    var sub: simd<int, 4> = a - b;
    var mul: simd<int, 4> = a * b;
    var band: simd<int, 4> = a & simd<int, 4>(15);
    print(add[0], add[1], add[2], add[3]);   // 13 23 33 43
    print(sub[0], sub[1], sub[2], sub[3]);   // 7 17 27 37
    print(mul[0], mul[1], mul[2], mul[3]);   // 30 60 90 120
    print(band[0], band[3]);                 // 10 8

    // 整数比较 → simd<bool, 4>
    var gt: simd<bool, 4> = a > b;
    print(gt[0], gt[3]);                     // true true

    // float2：逐 lane + 广播乘 + 浮点比较全谓词
    var f: simd<float, 2> = simd<float, 2>(1.5, 2.5);
    var g: simd<float, 2> = f * simd<float, 2>(2.0);
    print(g[0], g[1]);                       // 3.000000 5.000000
    var lt: simd<bool, 2> = f < g;
    var le: simd<bool, 2> = f <= g;
    var eq: simd<bool, 2> = f == g;
    var ge: simd<bool, 2> = f >= g;
    print(lt[0], lt[1]);                     // true true
    print(le[0], le[1]);                     // true true
    print(eq[0], eq[1]);                     // false false
    print(ge[0], ge[1]);                     // false false

    // byte4：无符号比较（200 > 100 真、1 > 100 假）+ lane 提取
    var by: simd<byte, 4> = simd<byte, 4>(
        int_to_byte(200), int_to_byte(1), int_to_byte(2), int_to_byte(3));
    var cmp: simd<bool, 4> = by > simd<byte, 4>(int_to_byte(100));
    print(byte_to_int(by[0]));               // 200
    print(cmp[0], cmp[1]);                   // true false

    // 布局内建（向量 ABI）
    print(sizeof<simd<int, 4>>());           // 32
    print(sizeof<simd<byte, 16>>());         // 16
    print(alignof<simd<byte, 16>>());        // 16
    return 0;
}
