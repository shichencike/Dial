// M7-e3ao：嵌套下标赋值 a[i][j] = v —— asm 后端递归左值解析（对齐 LLVM
// gen_assign_lvalue）。覆盖：多维读写 / push 后写 / COW 共享后写 / 多次嵌套写 /
// 句柄元素（string[]）嵌套写。刻意不把 get() 结果绑到局部变量——那是另一处
// 独立的借用-retain 缺口（见路线图），不在本用例覆盖范围内。
fn main(): int {
    var m: int[][] = [[1, 2, 3], [4, 5], [6, 7, 8, 9]];
    print(m.length());
    print(m[0].length());
    print(m[2][3]);

    // 扁平嵌套读取
    var i: int = 0;
    while (i < m.length()) {
        var j: int = 0;
        while (j < m[i].length()) {
            print(m[i][j]);
            j = j + 1;
        }
        i = i + 1;
    }

    // push 后写末行
    var inner: int[] = [100, 200];
    m.push(inner);
    print(m.length());
    print(m[3][1]);

    // 核心缺口：嵌套下标赋值
    m[0][0] = 11;
    print(m[0][0]);

    // 多次嵌套写
    m[1][0] = 44;
    print(m[1][0]);
    // push 字面量行后再写末行（COW 路径）
    var extra: int[] = [70, 80];
    m.push(extra);
    m[4][1] = 88;
    print(m[4][1]);

    return 0;
}
