// M7-e3an2：自研 asm 后端 select 双后端一致性黄金用例。
// 全部单线程、无随机调度，输出完全确定。

fn main(): int {
    // --- 场景1：空通道 + default（非阻塞，每轮立即走 default）---
    let empty: channel<string> = channel(2);
    var misses: int = 0;
    var i: int = 0;
    while (i < 3) {
        select {
            case recv(empty) as v {
                misses = misses - 1;
            }
            default {
                misses = misses + 1;
            }
        }
        i = i + 1;
    }
    print(misses);   // 3

    // --- 场景2：全体 EOF 直接结束 + 绑定变量内容 ---
    let ch: channel<string> = channel(2);
    var a: string = "hello";
    move_to(a, ch);
    close(ch);
    var got: int = 0;
    var rounds: int = 0;
    while (rounds < 4) {
        select {
            case recv(ch) as v {
                got = got + 1;
                print(v);    // hello（验证跨块传递的元素句柄正确）
            }
        }
        rounds = rounds + 1;
    }
    print(got);      // 1 —— 只有第一轮收到元素
    print(rounds);   // 4 —— 后三轮全体 EOF，select 直接结束

    // --- 场景3：双通道各一元素 + 已 close，统计总数（顺序随机但总数确定）---
    let chA: channel<string> = channel(2);
    let chB: channel<string> = channel(2);
    var x: string = "A";
    move_to(x, chA);
    var y: string = "B";
    move_to(y, chB);
    close(chA);
    close(chB);
    var total: int = 0;
    var k: int = 0;
    while (k < 5) {
        select {
            case recv(chA) as p { total = total + 1; }
            case recv(chB) as q { total = total + 1; }
        }
        k = k + 1;
    }
    print(total);    // 2 —— 两个元素各收到一次
    return 0;
}
