struct Pair { a: int, b: byte }

fn main(): int {
    print("asm backend hello");
    var x: int = 40;
    x = x + 2;
    print(x);
    if (x == 42) {
        print("answer");
    }
    // M7-e3ag：编译期布局内建双后端一致性（golden 逐字节 diff 覆盖）
    print(sizeof<int>(), alignof<int>(), sizeof<bool>(), sizeof<int32>());
    print(sizeof<Pair>(), alignof<Pair>(), offsetof<Pair>(b));
    return 0;
}
